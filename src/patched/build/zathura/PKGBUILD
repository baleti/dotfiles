# Local build of zathura from ~/src/patched/zathura (branch `local` = upstream tag + our patches).
# Generated/maintained by ~/src/patched/bin/patched-sync; do not publish.
pkgname=zathura-local
_upstream=zathura
pkgver=2026.10.4.r2.gaa6a2054
pkgrel=1
pkgdesc="Minimalistic document viewer (locally patched build)"
url="https://pwmt.org/projects/zathura/"
arch=('x86_64')
license=('Zlib')
depends=('girara' 'sqlite' 'desktop-file-utils' 'file' 'libsynctex' 'libseccomp' 'gtk4' 'glib2' 'json-glib' 'xxhash')
makedepends=('git' 'appstream' 'python-sphinx' 'texlive-bin' 'meson' 'ninja')
provides=("zathura=${pkgver}")
conflicts=('zathura')
source=("${_upstream}::git+file://${HOME}/src/patched/zathura#branch=local")
sha512sums=('SKIP')

pkgver() {
	cd "${_upstream}"
	# <upstream tag>.r<commits of our patches>.g<hash>
	git describe --long --tags | sed 's/^\([^-]*\)-\([0-9]*\)-g\(.*\)/\1.r\2.g\3/'
}

build() {
	cd "${_upstream}"
	arch-meson build -Dtests-x11=disabled -Dtests-wayland=disabled
	ninja -C build
}

package() {
	cd "${_upstream}"
	DESTDIR="${pkgdir}" ninja -C build install
	install -Dm 664 LICENSE "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
}
