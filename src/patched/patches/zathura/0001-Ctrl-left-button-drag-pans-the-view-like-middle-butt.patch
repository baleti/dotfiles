From b6cefda8fdfab74af29c7366c915bdb356d08fd2 Mon Sep 17 00:00:00 2001
From: baleti <baleti3266@gmail.com>
Date: Sun, 11 Oct 2026 15:56:02 +0100
Subject: [PATCH 1/2] Ctrl + left button drag pans the view (like middle-button
 drag)

Registers Ctrl+Button1 press/release/motion on sc_mouse_scroll, makes the
page widget skip text selection while that drag binding is active, and
treats the release after a real drag as not a click (no link follow or
synctex jump). A Ctrl+click without movement behaves as before.

Co-Authored-By: Claude Sonnet 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01E6J7Dgms4BH4yWufmn43ac
---
 zathura/config.c      |  8 ++++++++
 zathura/page-widget.c | 11 +++++++++++
 zathura/shortcuts.c   |  6 ++++--
 zathura/zathura.h     |  1 +
 4 files changed, 24 insertions(+), 2 deletions(-)

diff --git a/zathura/config.c b/zathura/config.c
index f57f6079..afdf638c 100644
--- a/zathura/config.c
+++ b/zathura/config.c
@@ -418,6 +418,14 @@ static void add_default_mouse_events(girara_session_t* gsession, girara_mode_t m
   girara_mouse_event_add(gsession, GDK_BUTTON2_MASK, GIRARA_MOUSE_BUTTON2, sc_mouse_scroll, mode,
                          GIRARA_EVENT_BUTTON_RELEASE, 0, NULL);
   girara_mouse_event_add(gsession, GDK_BUTTON2_MASK, 0, sc_mouse_scroll, mode, GIRARA_EVENT_MOTION_NOTIFY, 0, NULL);
+
+  /* Ctrl + left button drag pans as well */
+  girara_mouse_event_add(gsession, GDK_CONTROL_MASK, GIRARA_MOUSE_BUTTON1, sc_mouse_scroll, mode,
+                         GIRARA_EVENT_BUTTON_PRESS, 0, NULL);
+  girara_mouse_event_add(gsession, GDK_CONTROL_MASK | GDK_BUTTON1_MASK, GIRARA_MOUSE_BUTTON1, sc_mouse_scroll, mode,
+                         GIRARA_EVENT_BUTTON_RELEASE, 0, NULL);
+  girara_mouse_event_add(gsession, GDK_CONTROL_MASK | GDK_BUTTON1_MASK, 0, sc_mouse_scroll, mode,
+                         GIRARA_EVENT_MOTION_NOTIFY, 0, NULL);
 }
 
 void config_load_default(zathura_t* zathura) {
diff --git a/zathura/page-widget.c b/zathura/page-widget.c
index 1b957a06..77d732ae 100644
--- a/zathura/page-widget.c
+++ b/zathura/page-widget.c
@@ -1088,6 +1088,12 @@ static void cb_zathura_page_widget_button_release_event(GtkGestureClick* gesture
   const guint gbutton   = gtk_gesture_single_get_current_button(GTK_GESTURE_SINGLE(gesture));
   GdkModifierType state = gtk_event_controller_get_current_event_state(GTK_EVENT_CONTROLLER(gesture));
 
+  /* the end of a pan drag (e.g. Ctrl + left button) is not a click: no link, no synctex, no selection */
+  if (priv->zathura != NULL && priv->zathura->ui.session != NULL && priv->zathura->shortcut.mouse.dragged == true &&
+      girara_has_mouse_event(priv->zathura->ui.session, GIRARA_EVENT_BUTTON_RELEASE, gbutton, state) == true) {
+    return;
+  }
+
   /* signal payload, gtk4 events cannot be constructed by hand */
   scaled_button_release_event_t srelease = {.x = bx / scale, .y = by / scale, .button = gbutton, .state = state};
   g_signal_emit(page, signals[BUTTON_RELEASE], 0, &srelease);
@@ -1159,6 +1165,11 @@ static void cb_zathura_page_widget_motion_notify(GtkEventControllerMotion* contr
   GdkModifierType evstate      = gtk_event_controller_get_current_event_state(GTK_EVENT_CONTROLLER(controller));
 
   if (evstate & GDK_BUTTON1_MASK) { /* holding left mouse button */
+    /* a configured motion binding (Ctrl + left button pan) owns this drag, don't select text */
+    if (priv->zathura != NULL && priv->zathura->ui.session != NULL &&
+        girara_has_mouse_event(priv->zathura->ui.session, GIRARA_EVENT_MOTION_NOTIFY, 0, evstate) == true) {
+      return;
+    }
     zathura_page_widget_clear_selection(page);
     if (evstate & priv->zathura->global.highlighter_modmask) {
       double x, y;
diff --git a/zathura/shortcuts.c b/zathura/shortcuts.c
index 895f769a..38397aee 100644
--- a/zathura/shortcuts.c
+++ b/zathura/shortcuts.c
@@ -435,8 +435,9 @@ bool sc_mouse_scroll(girara_session_t* session, girara_argument_t* argument, gir
 
     /* drag */
   case GIRARA_EVENT_BUTTON_PRESS:
-    zathura->shortcut.mouse.x = event->x;
-    zathura->shortcut.mouse.y = event->y;
+    zathura->shortcut.mouse.x       = event->x;
+    zathura->shortcut.mouse.y       = event->y;
+    zathura->shortcut.mouse.dragged = false;
     break;
   case GIRARA_EVENT_BUTTON_RELEASE:
     zathura->shortcut.mouse.x = 0;
@@ -452,6 +453,7 @@ bool sc_mouse_scroll(girara_session_t* session, girara_argument_t* argument, gir
 
     position_set(zathura, position_moved_by(x_adj, zathura->shortcut.mouse.x - event->x),
                  position_moved_by(y_adj, zathura->shortcut.mouse.y - event->y));
+    zathura->shortcut.mouse.dragged = true;
     /* save the current cursor position so the next motion event measures only the new movement */
     zathura->shortcut.mouse.x = event->x;
     zathura->shortcut.mouse.y = event->y;
diff --git a/zathura/zathura.h b/zathura/zathura.h
index 85cd0493..3ba519a0 100644
--- a/zathura/zathura.h
+++ b/zathura/zathura.h
@@ -219,6 +219,7 @@ struct zathura_s {
     struct {
       int x;
       int y;
+      bool dragged;
     } mouse;
     struct {
       unsigned int pages;
