[Unit]
Description=Photo search server for the images picker (CLIP + faces, see ~/.config/indexes/photos.json)

[Service]
WorkingDirectory=%h/bin/index/photos
ExecStart=%h/.cache/indexes/venv/bin/python %h/bin/index/photos/search_server.py
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
