[Unit]
Description=Quickshell desktop shell (bar, wallpaper, launcher, pickers, OSD, alt-tab)
After=graphical-session.target
Wants=graphical-session.target

[Service]
Type=simple
Environment=LD_PRELOAD=%h/.config/hypr/mlockself/mlockself.so
ExecStart=/usr/bin/qs -n
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
