[Unit]
Description=Safety-net walk of the local file-name catalog (live changes come from catalog-watcher)

[Service]
Type=oneshot
WorkingDirectory=%h/bin/index/catalog
ExecStart=/usr/bin/nice -n 19 /usr/bin/ionice -c3 /usr/bin/python3 %h/bin/index/catalog/catalog.py build-local
Nice=19
IOSchedulingClass=idle
CPUWeight=10
CPUQuota=60%
MemoryMax=3G
TimeoutStartSec=30min
