[Unit]
Description=Ingest new btrfs (snapper) snapshots into the snapshot index (catalog-btrfs.db)

[Service]
Type=oneshot
WorkingDirectory=%h/bin/index/catalog
ExecStart=/usr/bin/nice -n 19 /usr/bin/ionice -c3 /usr/bin/python3 %h/bin/index/catalog/catalog.py build-btrfs
Nice=19
IOSchedulingClass=idle
CPUWeight=10
MemoryMax=2G
TimeoutStartSec=2h
