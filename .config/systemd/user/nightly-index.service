[Unit]
Description=Nightly incremental indexing (Recoll, Chroma, page-CLIP) - low priority, memory-capped

[Service]
Type=oneshot
WorkingDirectory=%h/bin/index/photos
ExecStartPre=/usr/bin/nice -n 19 /usr/bin/ionice -c3 %h/.cache/indexes/venv/bin/python %h/bin/index/tools/pdf_list.py %h/.cache/indexes/photos/pdf-list.tsv
ExecStart=/usr/bin/nice -n 19 /usr/bin/ionice -c3 /usr/bin/python3 %h/bin/index/photos/index_all.py
Nice=19
IOSchedulingClass=idle
CPUWeight=20
CPUQuota=200%
MemoryHigh=6G
MemoryMax=8G
TasksMax=512
TimeoutStartSec=12h
KillMode=control-group
