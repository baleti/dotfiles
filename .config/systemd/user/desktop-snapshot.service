[Unit]
Description=Snapshot Hyprland window layout + tmux/claude state + drive tmux-resurrect saves, for disaster recovery
After=graphical-session.target
Wants=graphical-session.target

[Service]
Type=simple
# resurrect-interval: kept at the original 300 -- the 19:02 2026-09-22
# CPU/memory spike (see sysmond history) was driven by save.sh's default
# save-command-strategy running a full-system `ps` dump per pane, not by
# scrollback size or the interval itself (see ~/.tmux.conf's
# @resurrect-save-command-strategy comment, which fixes the actual cause
# and keeps full pane-content capture). Session count here is expected to
# stay high long-term, so regular 300s recovery granularity matters more
# than it would for a short-lived spike in pane count.
ExecStart=/usr/bin/python3 %h/.config/desktop-snapshot/snapshot.py daemon --interval 300 --resurrect-interval 300
Restart=always
RestartSec=10
Nice=15
IOSchedulingClass=idle

[Install]
WantedBy=default.target
