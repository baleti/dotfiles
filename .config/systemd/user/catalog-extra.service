[Unit]
Description=Full walk of the NFS roots of the file-name catalog (host1 backups), safety net behind the live stream

[Service]
Type=oneshot
WorkingDirectory=%h/bin/index/catalog
ExecStart=/usr/bin/nice -n 19 /usr/bin/ionice -c3 /usr/bin/python3 %h/bin/index/catalog/catalog.py build-extra
Nice=19
IOSchedulingClass=idle
CPUWeight=10
MemoryMax=3G
TimeoutStartSec=2h
