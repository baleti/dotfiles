[Unit]
Description=Snapshot Hyprland window layout + tmux sessions/claude accounts for disaster recovery
After=graphical-session.target
Wants=graphical-session.target

[Service]
Type=simple
ExecStart=/usr/bin/python3 %h/.config/system-snapshot/snapshot.py daemon --interval 300
Restart=always
RestartSec=10
Nice=15
IOSchedulingClass=idle

[Install]
WantedBy=default.target
