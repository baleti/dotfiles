[Unit]
Description=Live updates for the Windows drives of the file-name catalog (change file written by SearchApp.exe --watch on the PC, followed over ssh)
After=network-online.target images-search.service
[Service]
WorkingDirectory=%h/bin/index/catalog
ExecStart=/usr/bin/nice -n 10 /usr/bin/python3 %h/bin/index/catalog/winwatch.py
Restart=always
RestartSec=10
Nice=10
CPUWeight=20
MemoryMax=1G
[Install]
WantedBy=default.target
