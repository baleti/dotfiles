      ]
    },
    {
      "keys": [
        "zz"
      ],
      "names": [
        "size",
        "path"
      ],
      "expect": null
    },
    {
      "keys": [
        "size",
        "zz"
      ],
      "names": [
        "size",
        "path"
      ],
      "expect": null
    }
  ],
  "direction": [
    {
      "word": "asc",
      "expect": "asc"
    },
    {
      "word": "a",
      "expect": "asc"
    },
    {
      "word": "ascending",
      "expect": "asc"
    },
    {
      "word": "desc",
      "expect": "desc"
    },
    {
      "word": "d",
      "expect": "desc"
    },
    {
      "word": "DESCENDING",
      "expect": "desc"
    },
    {
      "word": "",
      "expect": null
    },
    {
      "word": "zz",
      "expect": null
    },
    {
      "word": "descendingx",
      "expect": null
    }
  ],
  "splitcmd": {
    "verbs": {
      "": "fv",
      "fv": "fv",
      "filter-value": "fv",
      "ft": "ft",
      "at": "at",
      "rt": "rt",
      "s": "s",
      "sort": "s",
      "sw": "sw"
    },
    "maxParts": {
      "s": 3,
      "sw": 1
    },
    "cases": [
      {
        "text": "//title",
        "expect": [
          "fv",
          "title",
          null,
          false
        ]
      },
      {
        "text": "/fv/title",
        "expect": [
          "fv",
          "title",
          null,
          false
        ]
      },
      {
        "text": "/filter-value/p,q",
        "expect": [
          "fv",
          "p,q",
          null,
          false
        ]
      },
      {
        "text": "/s/title/desc",
        "expect": [
          "s",
          "title",
          "desc",
          false
        ]
      },
      {
        "text": "/sort/a,b",
        "expect": [
          "s",
          "a,b",
          null,
          false
        ]
      },
      {
        "text": "/s",
        "expect": [
          "s",
          null,
          null,
          false
        ]
      },
      {
        "text": "/fv",
        "expect": [
          "fv",
          null,
          null,
          false
        ]
      },
      {
        "text": "//",
        "expect": [
          "fv",
          "",
          null,
          false
        ]
      },
      {
        "text": "/fv/title/x",
        "expect": [
          "fv",
          "title",
          "x",
          true
        ]
      },
      {
        "text": "/s/a/b/c",
        "expect": [
          "s",
          "a",
          null,
          true
        ]
      },
      {
        "text": "/sw",
        "expect": [
          "sw",
          null,
          null,
          false
        ]
      },
      {
        "text": "/sw/x",
        "expect": [
          "sw",
          "x",
          null,
          true
        ]
      },
      {
        "text": "/usr/bin",
        "expect": null
      },
      {
        "text": "/",
        "expect": null
      },
      {
        "text": "title",
        "expect": null
      }
    ]
  },
  "substr": [
    {
      "needle": "rvt",
      "hay": "My RVT model",
      "exact": false,
      "expect": true
    },
    {
      "needle": "5",
      "hay": "5",
      "exact": true,
      "expect": true
    },
    {
      "needle": "5",
      "hay": "15",
      "exact": true,
      "expect": false
    },
    {
      "needle": "5",
      "hay": "a 5 b",
      "exact": true,
      "expect": true
    },
    {
      "needle": "5",
      "hay": "599",
      "exact": true,
      "expect": false
    },
    {
      "needle": "imp rom",
      "hay": "Imperial Rome",
      "exact": true,
      "expect": false
    },
    {
      "needle": "",
      "hay": "anything",
      "exact": false,
      "expect": true
    }
  ],
  "compare": [
    {
      "a": "10",
      "b": "2",
      "dir": "asc",
      "sign": 1
    },
    {
      "a": "10",
      "b": "2",
      "dir": "desc",
      "sign": -1
    },
    {
      "a": "5m",
      "b": "3h",
      "dir": "asc",
      "sign": 1
    },
    {
      "a": "5m",
      "b": "3h",
      "dir": "desc",
      "sign": -1
    },
    {
      "a": "abc",
      "b": "ABD",
      "dir": "asc",
      "sign": -1
    },
    {
      "a": "abc",
      "b": "ABD",
      "dir": "desc",
      "sign": 1
    },
    {
      "a": "x",
      "b": "X",
      "dir": "asc",
      "sign": 0
    }
  ],
  "impl": {
    "images-sort": {
      "_doc": "images picker (Rust) and the search CLI: fixed sort fields name path size date-modified extension depth pages (aliases dm, date)",
      "cases": [
        {
          "keys": "pa",
          "expect": [
            "pages",
            "path"
          ]
        },
        {
          "keys": "path",
          "expect": [
            "path"
          ]
        },
        {
          "keys": "dm",
          "expect": [
            "date"
          ]
        },
        {
          "keys": "date",
          "expect": [
            "date"
          ]
        },
        {
          "keys": "d",
          "expect": [
            "date",
            "depth"
          ]
        },
        {
          "keys": "zz",
          "expect": []
        }
      ]
    },
    "claudeagents-fields": {
      "_doc": "Android app: fixed types title account tokens age",
      "cases": [
        {
          "keys": "t",
          "expect": [
            "title",
            "tokens"
          ]
        },
        {
          "keys": "acc",
          "expect": [
            "account"
          ]
        },
        {
          "keys": "title,age",
          "expect": [
            "title",
            "age"
          ]
        }
      ]
    },
    "images-parse-sort": {
      "_doc": "images picker (Rust parse_sort) and the search command (parse_sort): the query with /s tokens removed, the sort keys, descending?, explicit? (fields name path size date-modified extension depth pages)",
      "cases": [
        {
          "query": "foo /s/size",
          "expect": [
            "foo",
            [
              "size"
            ],
            true,
            true
          ]
        },
        {
          "query": "foo /s/size/asc",
          "expect": [
            "foo",
            [
              "size"
            ],
            false,
            true
          ]
        },
        {
          "query": "/s/size,name/asc bar",
          "expect": [
            "bar",
            [
              "size",
              "name"
            ],
            false,
            true
          ]
        },
        {
          "query": "/s/pa",
          "expect": [
            "",
            [
              "pages",
              "path"
            ],
            true,
            true
          ]
        },
        {
          "query": "/s/path",
          "expect": [
            "",
            [
              "path"
            ],
            true,
            true
          ]
        },
        {
          "query": "/s/dm/d",
          "expect": [
            "",
            [
              "date"
            ],
            true,
            true
          ]
        },
        {
          "query": "/s/size /s/name",
          "expect": [
            "",
            [
              "size",
              "name"
            ],
            true,
            true
          ]
        },
        {
          "query": "/s/size /s/size",
          "expect": [
            "",
            [
              "size"
            ],
            true,
            true
          ]
        },
        {
          "query": "/s/zz x",
          "expect": [
            "x",
            [
              "date"
            ],
            true,
            false
          ]
        },
        {
          "query": "/s/size/zz x",
          "expect": [
            "x",
            [
              "date"
            ],
            true,
            false
          ]
        },
        {
          "query": "/s",
          "expect": [
            "",
            [
              "date"
            ],
            true,
            false
          ]
        },
        {
          "query": "/s size",
          "expect": [
            "size",
            [
              "date"
            ],
            true,
            false
          ]
        },
        {
          "query": "/sort/size/asc",
          "expect": [
            "",
            [
              "size"
            ],
            false,
            true
          ]
        },
        {
          "query": "//path /s/x /s/size",
          "expect": [
            "//path /s/x",
            [
              "size"
            ],
            true,
            true
          ]
        },
        {
          "query": "!//path /sort foo",
          "expect": [
            "!//path /sort foo",
            [
              "date"
            ],
            true,
            false
          ]
        },
        {
          "query": "/s/a/b/c",
          "expect": [
            "",
            [
              "date"
            ],
            true,
            false
          ]
        },
        {
          "query": "/sx",
          "expect": [
            "/sx",
            [
              "date"
            ],
            true,
            false
          ]
        },
        {
          "query": "name:\"/s/size x\" y",
          "expect": [
            "name:\"/s/size x\" y",
            [
              "date"
            ],
            true,
            false
          ]
        }
      ]
    }
  },
  "tokenize": [
    {
      "query": "a b",
      "expect": [
        [
          "a",
          false,
          false,
          false,
          0
        ],
        [
          "b",
          false,
          false,
          false,
          2
        ]
      ]
    },
    {
      "query": "\"a b\" c",
      "expect": [
        [
          "a b",
          true,
          true,
          false,
          0
        ],
        [
          "c",
          false,
          false,
          false,
          6
        ]
      ]
    },
    {
      "query": "!foo",
      "expect": [
        [
          "foo",
          false,
          false,
          true,
          1
        ]
      ]
    },
    {
      "query": "!\"a b\"",
      "expect": [
        [
          "a b",
          true,
          true,
          true,
          1
        ]
      ]
    },
    {
      "query": "\"unterminated x",
      "expect": [
        [
          "unterminated x",
          true,
          false,
          false,
          0
        ]
      ]
    },
    {
      "query": "'q r'",
      "expect": [
        [
          "q r",
          true,
          true,
          false,
          0
        ]
      ]
    },
    {
      "query": "it's fine",
      "expect": [
        [
          "it's",
          false,
          false,
          false,
          0
        ],
        [
          "fine",
          false,
          false,
          false,
          5
        ]
      ]
    },
    {
      "query": "a\"b c\"d",
      "expect": [
        [
          "ab cd",
          false,
          true,
          false,
          0
        ]
      ]
    },
    {
      "query": "//title \"imperial rome\" /s/age",
      "expect": [
        [
          "//title",
          false,
          false,
          false,
          0
        ],
        [
          "imperial rome",
          true,
          true,
          false,
          8
        ],
        [
          "/s/age",
          false,
          false,
          false,
          24
        ]
      ]
    },
    {
      "query": "  lead",
      "expect": [
        [
          "lead",
          false,
          false,
          false,
          2
        ]
      ]
    },
    {
      "query": "!",
      "expect": []
    },
    {
      "query": "a !b",
      "expect": [
        [
          "a",
          false,
          false,
          false,
          0
        ],
        [
          "b",
          false,
          false,
          true,
          3
        ]
      ]
    },
    {
      "query": "a! b",
      "expect": [
        [
          "a!",
          false,
          false,
          false,
          0
        ],
        [
          "b",
          false,
          false,
          false,
          3
        ]
      ]
    },
    {
      "query": "!!x",
      "expect": [
        [
          "!x",
          false,
          false,
          true,
          1
        ]
      ]
    },
    {
      "query": "",
      "expect": []
    }
  ],
  "splitraw": [
    {
      "query": "a b",
      "expect": [
        "a",
        "b"
