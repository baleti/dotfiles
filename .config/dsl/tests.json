{
  "_doc": "Conformance vectors for the query DSL primitives (query-dsl.md). Every implementation runs these: dsl.js (QML), dsl.py, and the Rust / Kotlin ports through their own `impl` groups.",
  "resolve": [
    {
      "keys": "p",
      "names": [
        "pid",
        "path",
        "title"
      ],
      "expect": [
        "pid",
        "path"
      ]
    },
    {
      "keys": "path",
      "names": [
        "pid",
        "path",
        "title"
      ],
      "expect": [
        "path"
      ]
    },
    {
      "keys": "title",
      "names": [
        "title",
        "tmux-title",
        "claude-title"
      ],
      "expect": [
        "title"
      ]
    },
    {
      "keys": "tit",
      "names": [
        "title",
        "tmux-title",
        "claude-title"
      ],
      "expect": [
        "title",
        "tmux-title",
        "claude-title"
      ]
    },
    {
      "keys": "tmux",
      "names": [
        "title",
        "tmux-session",
        "tmux-window"
      ],
      "expect": [
        "tmux-session",
        "tmux-window"
      ]
    },
    {
      "keys": "title,pid",
      "names": [
        "pid",
        "path",
        "title"
      ],
      "expect": [
        "pid",
        "title"
      ]
    },
    {
      "keys": "TITLE",
      "names": [
        "pid",
        "title"
      ],
      "expect": [
        "title"
      ]
    },
    {
      "keys": "",
      "names": [
        "pid",
        "title"
      ],
      "expect": []
    },
    {
      "keys": ",,",
      "names": [
        "pid",
        "title"
      ],
      "expect": []
    },
    {
      "keys": "a,,pid",
      "names": [
        "pid",
        "path",
        "title"
      ],
      "expect": [
        "pid",
        "path"
      ]
    },
    {
      "keys": "zz",
      "names": [
        "pid",
        "title"
      ],
      "expect": []
    }
  ],
  "sortkeys": [
