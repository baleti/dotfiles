    {
      "keys": [
        "path"
      ],
      "names": [
        "size",
        "path",
        "pages"
      ],
      "expect": [
        "path"
      ]
    },
    {
      "keys": [
        "size",
        "pa"
      ],
      "names": [
        "size",
        "path",
        "pages"
      ],
      "expect": [
        "size",
        "pages",
        "path"
      ]
    },
    {
      "keys": [
        "pa",
        "path"
      ],
      "names": [
        "size",
        "path",
        "pages"
      ],
      "expect": [
        "pages",
        "path"
      ]
    },
    {
      "keys": [
        "tmux"
      ],
      "names": [
        "tmux-window",
        "tmux-session",
        "age"
      ],
      "expect": [
        "tmux-session",
