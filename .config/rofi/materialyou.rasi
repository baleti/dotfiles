/* Generated by ~/.config/hypr/scripts/gen-theme.py. Re-styles the
 * widgets directly (rather than relying on @variable names the imported
 * system themes may or may not define) so this always takes effect
 * regardless of which base theme config.rasi imports. */
* {
    background-color: #1e1b16;
    text-color: #e8e2d9;
}
window {
    background-color: #1e1b16;
    border-color: #e8c349;
}
inputbar {
    background-color: #4c4639;
    text-color: #e8e2d9;
}
element {
    text-color: #e8e2d9;
}
element selected {
    background-color: #e8c349;
    text-color: #3c2f00;
}
element-text, element-icon {
    background-color: transparent;
}
