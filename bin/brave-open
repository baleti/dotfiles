#!/bin/sh
# Default-browser entry: local files get a per-directory sandbox with that dir
# whitelisted (brave-sandbox-open); everything else joins the shared firejail'd Brave.
if [ "$#" -eq 1 ]; then
  case "$1" in
    file://*) p=$(printf %s "${1#file://}" | python3 -c 'import sys,urllib.parse;print(urllib.parse.unquote(sys.stdin.read()),end="")'); exec /home/user1/bin/brave-sandbox-open "$p" ;;
    /*) exec /home/user1/bin/brave-sandbox-open "$1" ;;
  esac
fi
# Profile in ~/.config is a per-sandbox tmpfs, so seed the browserpass toolbar pin inside it.
exec firejail --quiet --profile=/etc/firejail/brave.profile sh -c 'd=$HOME/.config/BraveSoftware/Brave-Browser/Default; mkdir -p "$d"; echo "{\"extensions\":{\"pinned_extensions\":[\"pjmbgaakjkbhpopmakjoedenlfdmcdgm\"]}}" > "$d/Preferences"; exec brave --force-renderer-accessibility --load-extension="$HOME/.browserpass-ext" "$@"' brave "$@"
