#!/usr/bin/env python3
"""search: the mod+1 file search from the command line - same query language, same results, same ordering.

It asks the search server (images-search) the question the picker asks, so counts, ordering, verbs and the
view settings behave identically. Everything that is not an option is the query, quoted as one argument or not:

    search montgomer corpus '!pdf-to-png' .pdf          # '!' needs quoting in most shells
    search 'montgomer corpus !pdf-to-png .pdf' -n 20 -l
    search -c '//ext .pdf //size >10M'               # only the total and the summary (size, dates, kinds)
    search --json '/fts beta design //mime pdf' --snippets -n 5
    search -l --score '/chroma clash tolerances for BIM coordination //mime pdf'   # semantic, best first
    search -l --score '/clip brick wall'            # photos by what they show
    search -0 'name //ext .py' | xargs -0 wc -l      # NUL-separated paths for xargs
    search --no-dotfiles --backup restic 'report //ext .docx'
    search --syntax                                  # the query language in one page

Exit status: 0 results, 1 none (like grep), 2 the server could not be reached or refused the query.
"""
import argparse, json, os, subprocess, sys, time, urllib.error, urllib.parse, urllib.request

PAGE = 1000
SYNTAX = """QUERY LANGUAGE (identical to the mod+1 picker)

  words              every word must occur somewhere in the full path, case-insensitive:  montgomer corpus
  !word              leave out paths containing it:  !pdf-to-png        "a b"  a phrase with a space
  //name X           file name contains X                //path X   path contains X (gdrive/x = the Drive, ~/x = home)
  //ext .pdf         exact extension (repeat to OR)      //mime K    kind: image pdf text code document audio video archive ebook
  //size >5M <200K   file size (K M G T)                //dm 2024-06   modified in that month;  //dm >2015-06  after;  //dm <2020  before
  !//tag value       negates a tag, e.g.  !//ext .tmp

VERBS (anywhere in the query)

  /fts [words]       full-text search inside files (Recoll: AND, OR, "phrase", -term or !term), narrowed by //path //mime //name //size //dm; anything written BEFORE the verb is the name filter (alpha road /fts masonry);
                     /fts/<index> searches one index (a unique prefix is enough, e.g. /fts/part3)
  /chroma words      semantic search: files whose TEXT MEANS something close to the words (MiniLM embeddings over the same
                     content indexes), best first with a score; takes //path //mime //name //size too; /chroma/<index> for one.
                     The first use starts the worker (about 30 s); the total is what the nearest chunks cover, not every file.
  /clip words        photos matching what they show      /face name   photos showing a registered person
                     (--score shows the match score; --snippets prints the matching passages for /fts and /chroma)
  /s/FIELD[,FIELD][/asc|/desc]   sort by name, path, size, date-modified, extension, depth (chain with commas, e.g. /s/size,name/desc)
  /show-dotfiles  /hide-dotfiles                         names starting with a dot
  /show-backup  /hide-backup  (add -restic or -btrfs)    restic backups and btrfs snapshots (hidden by default)
  /show-fts-rvt  /hide-fts-rvt                           content searches (/fts, /chroma) include Revit files (rvt rfa rte rft); on by default
  /show-fts-dwg  /hide-fts-dwg                           the same for AutoCAD drawings (dwg dxf dwt)

The same settings exist as options: --dotfiles/--no-dotfiles, --backup restic|btrfs|all|none, --fts-rvt/--no-fts-rvt,
--fts-dwg/--no-fts-dwg, -s/--sort, --asc.
Attachments: text inside email attachments (.eml/.msg: pdf, docx, xlsx ...) IS full-text indexed - /fts on a word that only occurs
in an attached pdf returns the email file. Use --snippets to see the matching passage; --fields subject,from,date,attachments
(and --group-by thread) show what the email is without opening it.

NEVER bulk-read the file mounts (/mnt/backups, the Drive and other FUSE/NFS mounts: cat/grep -r/find over them is very slow
and hammers the server). Choose files with /fts ... --snippets (or -l), then read only the few you need.

Backup results have real paths under /mnt/backup-restic-host3/ids/<id>/... and <subvolume>/.snapshots/<n>/snapshot/...
"""

SORT_FIELDS = [("name", "name"), ("path", "path"), ("size", "size"), ("date-modified", "date"),
               ("extension", "ext"), ("depth", "depth"), ("pages", "pages")]

# ---- a faithful port of the picker's /s handling (images/src/main.rs parse_sort) --------------------------
def tokenize(q):
    out, cur, inq = [], [], False
    for ch in q:
        if ch == '"':
            inq = not inq
            cur.append(ch)
        elif ch.isspace() and not inq:
            if cur:
                out.append("".join(cur)); cur = []
        else:
            cur.append(ch)
    if cur:
        out.append("".join(cur))
    return out

def resolve_sort_fields(seg):
    """A /s key -> server keys: the exact name (or alias) alone, else EVERY field whose name contains it, in
    alphabetical order of the names (/s/pa = /s/pages,path). [] when it names nothing."""
    seg = seg.lower()
    if not seg:
        return []
    if seg in ("dm", "date"):
        return ["date"]
    for name, key in SORT_FIELDS:
        if name == seg:
            return [key]
    return [key for name, key in sorted(SORT_FIELDS) if seg in name]

def sort_direction(tok):
    t = tok.lower()
    if not t:
        return None
    asc, desc = t in "ascending", t in "descending"
    if asc and not desc:
        return False
    if desc and not asc:
        return True
    return None

def parse_sort(q):
    """(query without /s, sort keys, descending?, explicit?). One token per
    command, `/s/key[,key...][/dir]` (query-dsl.md "Grammar"); each /s adds
    keys, a key that resolves to nothing makes that /s inert, a keyless /s too."""
    toks, rest, keys, desc, explicit, i = tokenize(q), [], [], None, False, 0
    while i < len(toks):
        t = toks[i]; i += 1
        if t.startswith("//") or t.startswith("!//"):      # a //tag owns the next token, whatever it looks like
            rest.append(t)
            if i < len(toks):
                rest.append(toks[i]); i += 1
            continue
        if t.startswith("/sort"):
            chain = t[5:]
        elif t.startswith("/s"):
            chain = t[2:]
        else:
            rest.append(t)
            continue
        if chain == "":
            continue                                       # keyless: inert
        if not chain.startswith("/"):
            rest.append(t)
            continue
        parts = chain[1:].split("/")
        if len(parts) > 2:
            continue                                       # malformed: inert
        segs = [resolve_sort_fields(p) for p in parts[0].split(",") if p]
        direction = None
        if len(parts) == 2:
            direction = sort_direction(parts[1])
            if direction is None:
                continue                                   # bad direction: the whole /s is inert
        if segs and all(segs):
            if direction is not None:
                desc = direction
            explicit = True
            for k in (k for group in segs for k in group):
                if k not in keys:
                    keys.append(k)
    desc_v = True if not keys else (desc if desc is not None else False)
    if not keys:
        keys.append("date")
    return " ".join(rest), keys, desc_v, explicit

# ---- paths ---------------------------------------------------------------------------------------------------------
_remotes = None

def local_path(remote):
    """Photo results come as rclone paths (gdrive-crypt:photos/x.jpg); give the real path under the mount."""
    global _remotes
    if remote.startswith("/") or ":" not in remote:
        return remote
    if _remotes is None:
        _remotes = []
        try:
            cfg = json.load(open(os.path.expanduser("~/.config/indexes/photos.json")))
            _remotes = [(r["remote"], os.path.expanduser(r["mount"])) for r in cfg.get("catalog", {}).get("rclone", [])]
        except (OSError, ValueError, KeyError):
            pass
        if not _remotes:
            _remotes = [("gdrive-crypt:", os.path.expanduser("~/gdrive-rclone-crypt"))]
    for prefix, mount in _remotes:
        if remote.startswith(prefix):
            return mount.rstrip("/") + "/" + remote[len(prefix):].lstrip("/")
    return remote

# ---- server --------------------------------------------------------------------------------------------------------
class ServerDown(Exception):
    pass

def get(server, path, params, timeout=300):
    url = f"{server}{path}?" + urllib.parse.urlencode(params)
    last = None
    for attempt in range(2):                      # one retry: the server may have just restarted
        try:
            with urllib.request.urlopen(url, timeout=timeout) as r:
                return json.load(r)
        except urllib.error.HTTPError as e:
            raise RuntimeError(f"the server answered {e.code} {e.reason}")
        except (urllib.error.URLError, ConnectionError, TimeoutError, OSError) as e:
            last = e
            time.sleep(0.5)
    raise ServerDown(str(getattr(last, "reason", last)))

def fetch(server, query, keys, desc, offset, top, explicit=False):
    params = {"q": query, "sort": ",".join(keys), "desc": "1" if desc else "0", "offset": offset, "top": top,
              "explicit": "1" if explicit else "0"}
    waited = False
    for _ in range(60):                           # /chroma: the semantic worker starts on first use (about 30 s); wait for it
        r = get(server, "/query", params)
        if not any("semantic search is starting" in e for e in r.get("errors") or []):
            return r
        if not waited:
            print("search: starting the semantic search worker (about 30 s) ...", file=sys.stderr)
            waited = True
        time.sleep(3)
    return r

def start_server(server):
    print("search: the server is not running; starting images-search (about 30 s) ...", file=sys.stderr)
    subprocess.run(["systemctl", "--user", "start", "images-search.service"], check=False)
    deadline = time.time() + 120
    while time.time() < deadline:
        try:
            get(server, "/ver", {}, timeout=3)
            return True
        except (ServerDown, RuntimeError):
            time.sleep(2)
    return False

# ---- output --------------------------------------------------------------------------------------------------------
def email_info(path):
    """Headers (and attachment names) of one .eml, read from the file; {} when unreadable."""
    import email, email.policy
    try:
        with open(path, "rb") as f:
            m = email.message_from_binary_file(f, policy=email.policy.default)
        atts = [a.get_filename() for a in m.iter_attachments() if a.get_filename()]
        return {"subject": str(m["subject"] or ""), "from": str(m["from"] or ""), "to": str(m["to"] or ""),
                "date": str(m["date"] or ""), "attachments": atts}
    except Exception:
        return {}

def thread_key(subject):
    import re
    s = subject.lower()
    while True:
        t = re.sub(r"^\s*(re|fw|fwd|aw)\s*[:\-]\s*", "", s)
        if t == s:
            return " ".join(s.split())
        s = t

def human(n):
    if n is None:
        return "-"
    for unit in ("B", "KiB", "MiB", "GiB", "TiB"):
        if n < 1024 or unit == "TiB":
            return f"{n:.0f} {unit}" if unit == "B" else f"{n:.1f} {unit}"
        n /= 1024

def summary(count, stats):
    parts = [f"{count:,} shown"]
    if stats.get("size") is not None:
        parts.append(("≈ " if stats.get("approx") else "") + human(stats["size"]))   # sampled totals for huge result sets
    if stats.get("dmin"):
        parts.append(f"{stats['dmin']} → {stats['dmax']}")
    if stats.get("kinds"):
        parts.append(", ".join(f"{k} {n:,}" for k, n in stats["kinds"]))
    return " · ".join(parts)

def main():
    ap = argparse.ArgumentParser(description=__doc__.split("\n\n")[0], formatter_class=argparse.RawDescriptionHelpFormatter,
                                 epilog=__doc__.split("\n\n", 1)[1])
    ap.add_argument("query", nargs="*", help="the query (empty: the newest files)")
    sel = ap.add_argument_group("what to return")
    sel.add_argument("-n", "--limit", type=int, default=50, help="rows to print (default 50, 0 = all)")
    sel.add_argument("-s", "--sort", default=None, help="date (default), name, size, path, extension, depth; a/b chains keys")
    sel.add_argument("--asc", action="store_true", help="oldest / smallest / first first (default: newest first)")
    sel.add_argument("--dotfiles", dest="dotfiles", action="store_true", default=None, help="include names starting with a dot")
    sel.add_argument("--no-dotfiles", dest="dotfiles", action="store_false", help="leave them out")
    sel.add_argument("--backup", choices=["restic", "btrfs", "all", "none"], help="include / exclude backup copies")
    sel.add_argument("--fts-rvt", dest="fts_rvt", action="store_true", default=None, help="content searches (/fts /chroma) include Revit files (rvt rfa rte rft)")
    sel.add_argument("--no-fts-rvt", dest="fts_rvt", action="store_false", help="content searches leave out Revit files")
    sel.add_argument("--fts-dwg", dest="fts_dwg", action="store_true", default=None, help="include AutoCAD drawings")
    sel.add_argument("--no-fts-dwg", dest="fts_dwg", action="store_false", help="content searches leave out AutoCAD drawings")
    out = ap.add_argument_group("output")
    out.add_argument("-c", "--count", action="store_true", help="only the summary: count, size, dates, kinds")
    out.add_argument("-l", "--long", action="store_true", help="tab-separated: size, modified, path")
    out.add_argument("--json", action="store_true", help="JSON: one object per result (with -c: one summary object)")
    out.add_argument("-0", dest="nul", action="store_true", help="separate paths with NUL, for xargs -0")
    out.add_argument("--score", action="store_true", help="with -l: a leading score column (/clip, /face)")
    out.add_argument("--snippets", action="store_true", help="for /fts: the matching passages of each result (up to 50 rows)")
    out.add_argument("--raw", action="store_true", help="paths exactly as the server returns them (no mount mapping)")
    out.add_argument("--fields", help="comma list for .eml results: subject,from,to,date,attachments (read from the files; other rows show -)")
    out.add_argument("--group-by", choices=["thread"], help="with --fields/-l: group emails into threads (subject without Re:/Fw:), newest thread first")
    out.add_argument("-q", "--quiet", action="store_true", help="no summary line on stderr")
    srv = ap.add_argument_group("server")
    srv.add_argument("--server", default=os.environ.get("SEARCH_SERVER", "http://127.0.0.1:8765"),
                     help="search server (default %(default)s, or $SEARCH_SERVER)")
    srv.add_argument("--start", action="store_true", help="start images-search if it is not running, and wait")
    srv.add_argument("--syntax", action="store_true", help="print the query language and exit")
    a = ap.parse_args()
    if a.syntax:
        print(SYNTAX)
        return 0

    # query + sort: the /s verb wins over the options, as in the picker
    query, keys, desc, explicit = parse_sort(" ".join(a.query))
    if not explicit:
        explicit = bool(a.sort or a.asc)
        if a.sort:
            keys = [k for k in (resolve_sort_field(p) for p in a.sort.split("/")) if k] or ["date"]
            desc = not a.asc and keys == ["date"]
        elif a.asc:
            desc = False
    verbs = []
    if a.dotfiles is not None:
        verbs.append("/show-dotfiles" if a.dotfiles else "/hide-dotfiles")
    if a.fts_rvt is not None:
        verbs.append("/show-fts-rvt" if a.fts_rvt else "/hide-fts-rvt")
    if a.fts_dwg is not None:
        verbs.append("/show-fts-dwg" if a.fts_dwg else "/hide-fts-dwg")
    if a.backup:
        verbs.append({"restic": "/show-backup-restic", "btrfs": "/show-backup-btrfs", "all": "/show-backup", "none": "/hide-backup"}[a.backup])
    query = " ".join([query] + verbs).strip()

    t0 = time.time()
    try:
        try:
            first = fetch(a.server, query, keys, desc, 0, 1 if a.count else min(PAGE, a.limit or PAGE), explicit)
        except ServerDown:
            if not (a.start and start_server(a.server)):
                raise
            first = fetch(a.server, query, keys, desc, 0, 1 if a.count else min(PAGE, a.limit or PAGE), explicit)
    except ServerDown as e:
        print(f"search: cannot reach the search server at {a.server} ({e}).\n"
              f"        start it with:  systemctl --user start images-search   (or use --start)", file=sys.stderr)
        return 2
    except (RuntimeError, ValueError) as e:
        print(f"search: {e}", file=sys.stderr)
        return 2
    for err in first.get("errors") or []:
        print(f"search: {err}", file=sys.stderr)
    count, stats = first["count"], first.get("stats") or {}
    if a.count:
        if a.json:
            print(json.dumps({"query": query, "count": count, "size": stats.get("size"), "approximate": bool(stats.get("approx")),
                              "oldest": stats.get("dmin"), "newest": stats.get("dmax"),
                              "kinds": {k: n for k, n in stats.get("kinds", [])}}))
        else:
            print(summary(count, stats))
        return 0 if count else 1
    want = count if not a.limit else min(a.limit, count)
    rows, page = list(first["results"]), first
    try:
        while len(rows) < want:
            page = fetch(a.server, query, keys, desc, len(rows), min(PAGE, want - len(rows)), explicit)
            if not page["results"]:
                break
            rows += page["results"]
    except (ServerDown, RuntimeError, ValueError) as e:
        print(f"search: lost the server while paging: {e}", file=sys.stderr)
        return 2
    rows = rows[:want]
    snippets = {}
    if a.snippets:
        if len(rows) > 50:
            print("search: --snippets is limited to the first 50 rows", file=sys.stderr)
        for r in rows[:50]:
            try:
                snippets[r["remote"]] = get(a.server, "/snippets", {"remote": r["remote"], "q": query}, timeout=90).get("snippets") or []
            except (ServerDown, RuntimeError, ValueError):
                snippets[r["remote"]] = []
    end = "\0" if a.nul else "\n"
    fields = [f.strip() for f in a.fields.split(",")] if a.fields else []
    if a.group_by and not fields:
        fields = ["subject", "from", "date", "attachments"]
    info = {}
    if fields:
        bad = [f for f in fields if f not in ("subject", "from", "to", "date", "attachments")]
        if bad:
            print(f"search: unknown field {bad[0]} (subject, from, to, date, attachments)", file=sys.stderr)
            return 2
        for r in rows:
            pth = r["remote"] if a.raw else local_path(r["remote"])
            info[r["remote"]] = email_info(pth) if pth.lower().endswith(".eml") else {}
        def cell(r, f):
            v = info[r["remote"]].get(f)
            return "-" if not v else ("; ".join(v) if isinstance(v, list) else " ".join(str(v).split()))
        if a.group_by:
            groups = {}
            for r in rows:
                i = info[r["remote"]]
                groups.setdefault(thread_key(i.get("subject") or r["remote"]), []).append(r)
            rows = [r for g in groups.values() for r in sorted(g, key=lambda x: x.get("mtime") or "")]
            if not a.json:
                for key, g in groups.items():
                    sys.stdout.write(f"## {key or '(no subject)'}  [{len(g)} emails]\n")
                    for r in sorted(g, key=lambda x: x.get("mtime") or ""):
                        pth = r["remote"] if a.raw else local_path(r["remote"])
                        sys.stdout.write("\t".join([cell(r, f) for f in fields] + [pth]) + "\n")
                sys.stdout.flush()
                rows = []
    try:
        for r in rows:
            if fields and not a.json:
                pth = r["remote"] if a.raw else local_path(r["remote"])
                sys.stdout.write("\t".join([cell(r, f) for f in fields] + [pth]) + end)
                continue
            path = r["remote"] if a.raw else local_path(r["remote"])
            if a.json:
                o = {"path": path, "size": r.get("size"), "mtime": r.get("mtime")}
                if r.get("score") is not None:
                    o["score"] = r["score"]
                for f in fields:
                    o[f] = info[r["remote"]].get(f)
                if a.group_by:
                    o["thread"] = thread_key(info[r["remote"]].get("subject") or "")
                if a.snippets:
                    o["snippets"] = [{"page": s.get("page"), "text": s.get("text")} for s in snippets.get(r["remote"], [])]
                sys.stdout.write(json.dumps(o) + "\n")
            elif a.long:
                score = f"{r['score']:.4f}\t" if a.score and r.get("score") is not None else ("-\t" if a.score else "")
                sys.stdout.write(f"{score}{r['size'] if r.get('size') is not None else '-'}\t{r.get('mtime') or '-'}\t{path}\n")
            else:
                sys.stdout.write(path + end)
            if a.snippets and not a.json:
                for s in snippets.get(r["remote"], [])[:3]:
                    page_no = f"p.{s['page']}: " if s.get("page") is not None else ""
                    sys.stdout.write(f"    {page_no}{' '.join((s.get('text') or '').split())}\n")
        sys.stdout.flush()
    except BrokenPipeError:
        pass
    if not a.quiet:
        trunc = want < count
        if trunc:
            print(f"search: showing {want:,} of {count:,} - use -n N (or -n 0 for all) to see more, or narrow the query", file=sys.stderr)
        if sys.stderr.isatty():
            shown = f" (showing {want:,})" if trunc else ""
            print(f"{summary(count, stats)}{shown} · {time.time() - t0:.2f}s", file=sys.stderr)
    return 0 if count else 1

if __name__ == "__main__":
    sys.exit(main())
