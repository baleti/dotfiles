#!/bin/bash
# RDP into one of the offline Windows/Revit VMs on host2 by vsock CID (no network in the VMs).
# usage: rdp-windows-vm <cid> [extra xfreerdp3 args]      e.g. 3 = interactive dev VM, 4/6/7/8 = held CI VMs
# Path: host3 -> ssh -L (33390+CID) -> host2 socat -> vsock CID:3389 -> guest relay -> RDP. The account password is blank (no prompt).
# The tunnel is checked end to end (an RDP handshake must answer); a stale tunnel is replaced.
CID=${1:?usage: rdp-windows-vm <cid> [xfreerdp3 args]}; shift
PORT=$((33390 + CID)); RPORT=$((34380 + CID))
H2=192.168.1.13; KEY=~/.ssh/host2-ssh-auth
probe() { timeout 6 bash -c "exec 3<>/dev/tcp/127.0.0.1/$PORT && printf '\x03\x00\x00\x13\x0e\xe0\x00\x00\x00\x00\x00\x01\x00\x08\x00\x03\x00\x00\x00' >&3 && head -c 4 <&3 | od -An -tx1 | grep -q '03 00'" 2>/dev/null; }
if ! probe; then
  old=$(ss -ltnp 2>/dev/null | sed -n "s/.*127.0.0.1:$PORT .*pid=\([0-9]*\).*/\1/p" | head -1)
  [ -n "$old" ] && kill "$old" 2>/dev/null && sleep 1
  ssh -i $KEY user@$H2 "ss -ltn | grep -q 127.0.0.1:$RPORT || setsid socat TCP-LISTEN:$RPORT,bind=127.0.0.1,fork,reuseaddr VSOCK-CONNECT:$CID:3389 >/dev/null 2>&1 < /dev/null &" || exit 1
  ssh -i $KEY -o ExitOnForwardFailure=yes -o ServerAliveInterval=30 -f -N -L $PORT:127.0.0.1:$RPORT user@$H2 >/dev/null 2>&1 || exit 1
  for i in $(seq 1 20); do probe && break; sleep 0.5; done
  probe || { echo "rdp-windows-vm: tunnel is up but RDP of CID $CID does not answer (VM not running, or not logged in yet?)" >&2; notify-send "Revit VM $CID" "RDP does not answer (VM not running or not logged in yet?)" 2>/dev/null; exit 1; }
fi
[ "${RDP_PROBE_ONLY:-0}" = 1 ] && { echo "CID $CID: RDP answers on 127.0.0.1:$PORT"; exit 0; }
nohup xfreerdp3 /v:127.0.0.1:$PORT /d: /u:User /p: /cert:ignore +dynamic-resolution +clipboard -drives "/title:Revit VM CID $CID" "$@" >/dev/null 2>&1 < /dev/null &
disown
