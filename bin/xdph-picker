#!/usr/bin/env bash
# xdg-desktop-portal-hyprland custom picker (screencopy:custom_picker_binary).
# Teams has its own share UI, so when it's the focused window answer the portal
# with HDMI-A-1 straight away; every other app (or if anything below fails) gets the stock picker.
# The portal inherits HYPRLAND_INSTANCE_SIGNATURE from the systemd user env, which goes stale
# when Hyprland restarts, so always use the newest instance instead.
sig=$(ls -t "${XDG_RUNTIME_DIR:-/run/user/$UID}/hypr" 2>/dev/null | head -1)
[[ -n $sig ]] && export HYPRLAND_INSTANCE_SIGNATURE=$sig
target=HDMI-A-1
class=$(hyprctl activewindow -j 2>/dev/null | jq -r '.class // ""')
if [[ $class == brave-teams.microsoft.com__* || $class == brave-teams.live.com__* ]] \
   && hyprctl monitors -j 2>/dev/null | jq -e --arg n "$target" 'any(.[]; .name == $n)' >/dev/null; then
    if [[ $1 == --dry-run ]]; then echo "auto: [SELECTION]/screen:$target"; exit 0; fi
    echo "[SELECTION]/screen:$target"
    exit 0
fi
[[ $1 == --dry-run ]] && { echo "stock picker (class='$class')"; exit 0; }
exec /usr/bin/hyprland-share-picker "$@"
