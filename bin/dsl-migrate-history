#!/usr/bin/env python3
"""Rewrites picker search-box history files from the old query-DSL syntax to the
current one (query-dsl.md "Grammar", 2026-10-22):

  /fv path:value        ->  //path value        /fv word        ->  word
  /fv/claude.title x    ->  /fv/claude-title x   (dots -> hyphens, .* dropped)
  /s name desc          ->  /s/name/desc         /s/a/b desc     ->  /s/a,b/desc
  /at path              ->  /at/path             (also /ft /rt, long forms)
  /fts.claude x         ->  /fts/claude-live x   /fts.resume x   ->  /fts/claude-archive x
  /fts.claude.resume x  ->  /fts/claude-archive x

usage: dsl-migrate-history [--dry-run] [FILE...]   (no FILE = every known history file)"""
import json, os, re, sys

HOME = os.path.expanduser("~")
FILES = [f"{HOME}/.cache/quickshell/{n}-query-history.json" for n in ("claude-usage", "launcher", "rssreader", "winswitch")] + \
        [f"{HOME}/.cache/claude-history-query-history", f"{HOME}/.cache/tmux-focus-picker-history"]
VERBS = {"fv": "fv", "filter-value": "fv", "ft": "ft", "filter-type": "ft", "at": "at", "add-type": "at",
         "rt": "rt", "remove-type": "rt", "s": "s", "sort": "s"}
FAMILY = re.compile(r"\b(tmux|claude|hypr|ssh)\.([a-z*]+)")


def tokens(q):
    """[(text, negated_prefix)] keeping quotes verbatim; whitespace-split outside quotes."""
    out, i = [], 0
    while i < len(q):
        if q[i].isspace():
            i += 1
            continue
        j = i
        quote = None
        while j < len(q) and (quote or not q[j].isspace()):
            if q[j] in "\"'" and (quote is None):
                quote = q[j]
            elif q[j] == quote:
                quote = None
            j += 1
        out.append(q[i:j])
        i = j
    return out


def fix_names(path):
    path = path.replace("claude.time", "claude-age").replace("claude.fts", "claude-fts")
    path = re.sub(r"\.\*", "", path)
    return FAMILY.sub(lambda m: f"{m.group(1)}-{m.group(2)}", path)


def is_cmd(t):
    t = t.lstrip("!")
    return t.startswith("/") and (t[1:].split("/")[0] in VERBS or t[1:].split("/")[0] in ("", "fts", "sw")
                                  or t[1:].startswith("fts.") or t[1:] == "sw")


def migrate(q):
    toks = tokens(q)
    out, i = [], 0
    while i < len(toks):
        t = toks[i]
        i += 1
        neg = "!" if t.startswith("!") else ""
        b = t[len(neg):]
        # old /fts spellings
        m = re.fullmatch(r"/fts\.claude\.resume|/fts\.resume|/fts/archive|/fts/claude/archive", b)
        if m:
            out.append(neg + "/fts/claude-archive")
            continue
        if re.fullmatch(r"/fts\.claude|/fts/live|/fts/claude/live", b):
            out.append(neg + "/fts/claude-live")
            continue
        if b.startswith("/") and b[1:].split("/")[0] == "fts":
            out.append(neg + fix_names(b))
            continue
        # $field:value (very old claude-history / window-search spelling)
        m = re.fullmatch(r"\$([a-zA-Z.-]+):(.*)", b)
        if m:
            out.append(f"{neg}//{fix_names(m.group(1))} {m.group(2)}")
            continue
        if not b.startswith("/"):
            out.append(t)
            continue
        parts = b[1:].split("/")
        verb = VERBS.get(parts[0])
        if parts[0] == "" and len(parts) >= 2:          # //keys value - already new, fix names
            out.append(neg + "//" + fix_names("/".join(parts[1:])))
            continue
        if parts[0] == "sw":
            out.append(neg + "/sw")                      # /sw/<x> sugar is gone: /sw then //<x>
            if len(parts) > 1 and parts[1]:
                nxt = toks[i] if i < len(toks) and not is_cmd(toks[i]) else None
                out.append("//" + fix_names("/".join(parts[1:])) + ((" " + nxt) if nxt else ""))
                if nxt:
                    i += 1
            continue
        if verb is None:
            out.append(t)
            continue
        arg = toks[i] if i < len(toks) and not is_cmd(toks[i]) else None
        if len(parts) >= 2 and parts[1]:                 # via form: /verb/keys[...]
            keys = fix_names(parts[1])
            if verb == "fv":
                out.append(f"{neg}/fv/{keys}")
                if arg is not None:
                    out.append(arg); i += 1
            elif verb == "s":
                chain = [fix_names(p) for p in parts[1:]]
                direction = None
                if arg is not None and re.fullmatch(r"a(s(c(e(n(d(i(ng?)?)?)?)?)?)?)?|d(e(s(c(e(n(d(i(ng?)?)?)?)?)?)?)?)?", arg.lower()):
                    direction = "desc" if arg.lower().startswith("d") else "asc"
                    i += 1
                out.append(f"{neg}/s/{','.join(chain)}" + (f"/{direction}" if direction else ""))
            else:
                out.append(f"{neg}/{verb}/{keys}")
            continue
        # space form: /verb arg
        if arg is None:
            continue                                      # keyless verb: dropped
        i += 1
        if verb == "fv":
            if ":" in arg and not arg.startswith(("\"", "'")):
                path, _, value = arg.partition(":")
                out.append(f"{neg}//{fix_names(path)} {value}" if value else f"{neg}//{fix_names(path)}")
            else:
                out.append(("!" if neg else "") + arg.lstrip("!"))   # /fv word == word
        elif verb == "s":
            direction = None
            if i < len(toks) and re.fullmatch(r"a(s(c(e(n(d(i(ng?)?)?)?)?)?)?)?|d(e(s(c(e(n(d(i(ng?)?)?)?)?)?)?)?)?", toks[i].lower()):
                direction = "desc" if toks[i].lower().startswith("d") else "asc"
                i += 1
            out.append(f"{neg}/s/{fix_names(arg)}" + (f"/{direction}" if direction else ""))
        else:
            out.append(f"{neg}/{verb}/{fix_names(arg)}")
    return " ".join(out)


def main():
    args = sys.argv[1:]
    dry = "--dry-run" in args
    files = [a for a in args if not a.startswith("--")] or FILES
    for f in files:
        if not os.path.exists(f):
            continue
        raw = open(f).read()
        if f.endswith(".json"):
            old = json.loads(raw)
        else:
            old = raw.splitlines()
        new, seen = [], set()
        for q in old:
            n = migrate(q)
            if n and n not in seen:
                seen.add(n)
                new.append(n)
        changed = [(a, b) for a, b in zip(old, [migrate(q) for q in old]) if a != b]
        print(f"{f}: {len(old)} entries, {len(changed)} rewritten")
        for a, b in changed:
            print(f"   {a!r} -> {b!r}")
        if not dry and old != new:
            open(f + ".bak", "w").write(raw)
            open(f, "w").write(json.dumps(new) if f.endswith(".json") else "\n".join(new) + "\n")


if __name__ == "__main__":
    main()
