#!/usr/bin/env python3
"""Open files (or every file in the given folders) in their default apps and
stack all the resulting windows into ONE Hyprland group (tabs).

Usage: group-open [--head N | --tail N] [--workspace N] [--delay S] FILE_OR_DIR...

--head N / --tail N open only the first / last N files of the (sorted) list.

Step through the tabs with mod+[ / mod+] (hl.dsp.group.prev/next).
Folder contents are opened in natural sort order ("2 x" before "10 x").

The app for each file is the mime type's default (xdg-mime -> .desktop Exec).
Override per mime type in OVERRIDES; "{}" is replaced by the quoted file path.
"""
from concurrent.futures import ThreadPoolExecutor
import argparse, glob, hashlib, json, mimetypes, re, shlex, shutil, signal, os, re, shlex, subprocess, sys, time

# mime type -> shell command, e.g. {"image/png": "mpv --no-config {}"}
OVERRIDES = {
}

APP_DIRS = [os.path.expanduser("~/.local/share/applications"),
            "/usr/local/share/applications", "/usr/share/applications"]
# Private, never-focused workspace the windows open on. It is unique to this run, so a
# window sitting on it is ours by construction (identified by its Hyprland address, never
# by "whatever just appeared" or by what is focused).
STAGE = 20000 + os.getpid() % 10000
BUILD = STAGE + 1   # private empty workspace a busy workspace's group is taken to while slides are merged into it
TIMEOUT = 20  # seconds to wait for each window to appear


T0 = time.time()


def hypr_env():
    """The environment to run hyprctl and the capture backend in. Uses the shell's
    HYPRLAND_INSTANCE_SIGNATURE only if that instance's socket really exists: a tmux pane
    keeps the value from the session it was started in, so after a relogin or a Hyprland
    restart it can be missing or stale; then the newest live instance is used."""
    env = dict(os.environ)
    rt = env.get("XDG_RUNTIME_DIR", f"/run/user/{os.getuid()}") + "/hypr"
    sig = env.get("HYPRLAND_INSTANCE_SIGNATURE", "")
    if not (sig and os.path.exists(f"{rt}/{sig}/.socket.sock")):
        live = [d for d in glob.glob(f"{rt}/*") if os.path.exists(f"{d}/.socket.sock")]
        if live:
            env["HYPRLAND_INSTANCE_SIGNATURE"] = os.path.basename(max(live, key=os.path.getmtime))
    return env


ENV = hypr_env()


TRACE = os.environ.get("GROUP_OPEN_TRACE")


def hyprctl(*args):
    t = time.time()
    out = subprocess.run(["hyprctl", *args], env=ENV, capture_output=True, text=True).stdout
    if TRACE and time.time() - t > 0.05:
        print(f"TRACE {time.time() - T0:7.2f}s hyprctl {args[0]} took {1000 * (time.time() - t):.0f}ms", file=sys.stderr)
    return out


_last_clients = []


def clients():
    """hyprctl's window list. Under heavy load it sometimes answers with something
    that is not JSON; retry briefly, then fall back to the last good list."""
    global _last_clients
    for _ in range(4):
        try:
            _last_clients = json.loads(hyprctl("clients", "-j"))
            return _last_clients
        except ValueError:
            time.sleep(0.1)
    return _last_clients


def cpu_temp():
    """Hottest coretemp sensor in degrees C, or 0 if none can be read."""
    best = 0.0
    for d in glob.glob("/sys/class/hwmon/hwmon*"):
        try:
            if open(f"{d}/name").read().strip() != "coretemp":
                continue
            for t in glob.glob(f"{d}/temp*_input"):
                best = max(best, int(open(t).read()) / 1000)
        except (OSError, ValueError):
            pass
    return best


def psi(resource):
    """Kernel pressure-stall 'some avg10' for cpu or memory (percent of the last
    10 s some task was stalled waiting for it); 0 if unavailable."""
    try:
        return float(open(f"/proc/pressure/{resource}").readline().split("avg10=")[1].split()[0])
    except (OSError, IndexError, ValueError):
        return 0.0


class Cpu:
    """Whole-machine CPU utilisation (0-100) since the previous call, from /proc/stat."""

    def __init__(self):
        self._prev = self._read()

    @staticmethod
    def _read():
        f = open("/proc/stat").readline().split()[1:]
        v = [int(x) for x in f]
        return sum(v), v[3] + v[4]          # total, idle + iowait

    def percent(self):
        total, idle = self._read()
        dt, di = total - self._prev[0], idle - self._prev[1]
        self._prev = (total, idle)
        return 100.0 * (dt - di) / dt if dt > 0 else 0.0


def lua(code):
    return hyprctl("eval", code)


def natural(s):
    return [int(t) if t.isdigit() else t.lower() for t in re.split(r"(\d+)", s)]


def collect(paths):
    out = []
    for p in paths:
        p = os.path.abspath(os.path.expanduser(p))
        if os.path.isdir(p):
            names = sorted((n for n in os.listdir(p) if not n.startswith(".")), key=natural)
            out += [os.path.join(p, n) for n in names if os.path.isfile(os.path.join(p, n))]
        elif os.path.isfile(p):
            out.append(p)
        else:
            sys.exit(f"group-open: no such file or directory: {p}")
    return out


CACHE = os.path.expanduser("~/.cache/group-open")


def scaled_copy(path, max_edge):
    """Path of a copy of `path` whose long edge is at most max_edge (made once with vips,
    cached under ~/.cache/group-open, the original is never touched); `path` itself if it
    is not a large raster image or anything goes wrong.

    Why: a 4963x7019 slide is decoded to ~140 MB per viewer (and ~0.5 s of one core at
    full turbo, which is where the heat comes from). A viewer holding 48 of those pushes
    the compositor's own pages out to swap, which freezes the desktop. At 3000 px a slide
    is ~25 MB and decodes five times faster, and is still sharper than any monitor here."""
    if not max_edge:
        return path
    mime = mime_of(path)
    ext = os.path.splitext(path)[1].lower()
    if not mime.startswith("image/") or ext not in (".png", ".jpg", ".jpeg"):
        return path
    try:
        w, h = (int(subprocess.run(["vipsheader", "-f", f, path], capture_output=True, text=True,
                                   timeout=20).stdout) for f in ("width", "height"))
        st = os.stat(path)
    except (OSError, ValueError, subprocess.SubprocessError):
        return path
    if max(w, h) <= max_edge:
        return path
    key = hashlib.sha1(f"{path}|{st.st_mtime_ns}|{st.st_size}|{max_edge}".encode()).hexdigest()[:16]
    out = os.path.join(CACHE, key, os.path.basename(path))   # same file name: titles/labels stay readable
    if os.path.exists(out):
        return out
    opts = "[compression=1,strip]" if ext == ".png" else "[Q=95,strip]"
    tmp = os.path.join(CACHE, key, "part-" + os.path.basename(path))
    try:
        os.makedirs(os.path.dirname(out), exist_ok=True)
        pin = ["taskset", "-c", ECORES] if ECORES else []
        r = subprocess.run([*pin, "nice", "-n", "19", "vipsthumbnail", path, "-s", f"{max_edge}x{max_edge}>",
                            "-o", tmp + opts], capture_output=True, text=True, timeout=120)
        if r.returncode == 0 and os.path.exists(tmp):
            os.replace(tmp, out)
            return out
    except (OSError, subprocess.SubprocessError):
        pass
    return path


def mime_of(path):
    r = subprocess.run(["xdg-mime", "query", "filetype", path], capture_output=True, text=True)
    return r.stdout.strip() or mimetypes.guess_type(path)[0] or "application/octet-stream"


def mime_candidates(mime):
    """The type and every name it is known by: the system reports e.g. video/matroska
    while the default player is registered under its canonical name video/x-matroska
    (from /usr/share/mime/aliases), then the parent types (subclasses)."""
    alias_to_canon, canon_to_aliases, parents = {}, {}, {}
    for fname, fn in (("aliases", None), ("subclasses", None)):
        try:
            for line in open(f"/usr/share/mime/{fname}"):
                parts = line.split()
                if len(parts) != 2:
                    continue
                if fname == "aliases":
                    alias_to_canon[parts[0]] = parts[1]
                    canon_to_aliases.setdefault(parts[1], []).append(parts[0])
                else:
                    parents.setdefault(parts[0], []).append(parts[1])
        except OSError:
            pass
    out = [mime]
    def add(m):
        if m and m not in out:
            out.append(m)
    add(alias_to_canon.get(mime))
    for al in canon_to_aliases.get(mime, []):
        add(al)
    i = 0
    while i < len(out):                      # parent types, breadth first
        for par in parents.get(out[i], []):
            add(par)
            add(alias_to_canon.get(par))
        i += 1
    return out


def desktop_exec(mime):
    for m in mime_candidates(mime):
        d = subprocess.run(["xdg-mime", "query", "default", m], capture_output=True, text=True).stdout.strip()
        if not d:
            continue
        for base in APP_DIRS:
            f = os.path.join(base, d)
            if os.path.exists(f):
                for line in open(f, errors="replace"):
                    if line.startswith("Exec="):
                        return line[5:].strip()
    return None


def command_for(path):
    """Shell command that opens `path`, or None if there is no application for it.
    There is deliberately no xdg-open fallback: it starts the application through a
    different process tree, which escapes Hyprland's silent launch rule (the window would
    open on the user's visible workspace and take focus)."""
    mime = mime_of(path)
    q = shlex.quote(path)
    if mime in OVERRIDES:
        return OVERRIDES[mime].replace("{}", q)
    ex = desktop_exec(mime)
    if not ex:
        return None
    ex = re.sub(r"%[fFuU]", q, ex)          # we pass exactly one file
    return re.sub(r"%[a-zA-Z%]", "", ex)    # drop %i %c %k etc.


def slice_name(label):
    """systemd slice all of this run's viewers live in: `systemd-cgls` shows the run as one
    subtree, htop's CGROUP column shows it per process, and `systemctl --user status
    <slice>` gives the run's total CPU / memory."""
    safe = re.sub(r"[^A-Za-z0-9]+", "-", label).strip("-")[:30] or "run"
    return f"groupopen-{safe}-{os.getpid()}.slice"


SLICE = None   # set in main()


def efficiency_cores():
    """CPU list of the efficiency cores on a hybrid Intel CPU ("4-11"), else None. The image
    work (decoding, scaling) is pinned there: the performance cores turbo to 4.4 GHz and
    spike the package temperature within a fraction of a second; the E-cores top out at
    3.3 GHz and run far cooler for the same work, which is plenty for loading slides."""
    try:
        return open("/sys/devices/cpu_atom/cpus").read().strip() or None
    except OSError:
        return None


ECORES = None   # set in main() unless --no-pin


def spawn(cmd, workspace):
    """Start a viewer through Hyprland's own exec, with a launch rule that opens it on the
    given workspace WITHOUT taking focus (`silent`). Nothing else I tried can stop a new
    window being focused: window properties, tags and rules on the destination workspace
    were all measured and none prevents it, and the launch rule only applies to processes
    Hyprland itself starts. So viewers are Hyprland's children, not ours; they are grouped
    by cgroup instead (see slice_name). Low CPU / I/O priority: slides load in the
    background and never at the desktop's expense."""
    pin = f"taskset -c {ECORES} " if ECORES else ""
    inner = f"exec {pin}nice -n 15 ionice -c2 -n7 {cmd}"
    if SLICE and shutil.which("systemd-run"):
        inner = (f"exec systemd-run --user --scope --quiet --slice={SLICE} "
                 f"-p CPUWeight=20 -p IOWeight=20 -p MemoryHigh=500M -- /bin/sh -c {shlex.quote(inner)}")
    rule = f"workspace {workspace} silent"
    lua(f'hl.dispatch(hl.dsp.exec_cmd({json.dumps("[" + rule + "] " + inner)}))')


def win_lua(addr):
    return f'(function() for _,w in ipairs(hl.get_windows()) do if w.address=="{addr}" then return w end end end)()'


def focus_if_on(addr, ws):
    """Focus addr only if the user is still looking at workspace ws."""
    lua(f'(function() local w={win_lua(addr)} if w and hl.get_active_workspace().id=={ws} then hl.dispatch(hl.dsp.focus({{window=w}})) end end)()')


def move_ws(addr, ws):
    lua(f'(function() local w={win_lua(addr)} if w then hl.dispatch(hl.dsp.window.move({{workspace={ws}, window=w, follow=false}})) end end)()')


def is_solitary(leader, addrs, ws):
    """True if the leader's group is the only thing on ws (ignoring `addrs`, which are
    about to join): then Hyprland merges windows moved onto ws with no resizing at all."""
    members = set(next((c["grouped"] for c in clients() if c["address"] == leader), [])) | {leader}
    return not any(c["workspace"]["id"] == ws and c["address"] not in members | set(addrs)
                   for c in clients())


def merge_batch(leader, addrs, ws):
    """Append every window in addrs (file order) to leader's group in ONE Lua call.

    Everything is addressed by Hyprland window address. The group's current tab and its focus
    are remembered first and put back at the end of the same call, so a user who is
    flipping through pages keeps their page and their keyboard focus while windows join.

    How windows join depends on what else is on ws:
    - the group is alone there: windows are moved onto ws and Hyprland merges them into
      it. Measured: the visible slide receives no X11 events at all.
    - other windows share ws: a window joining next to the group would re-tile the
      workspace and resize the visible slide each time (measured: ~5 resizes, focus
      changes and redraws per window). So the whole group is taken to the private empty
      workspace BUILD, the windows are merged there, and the group is brought back:
      one small change per batch instead of several per window.

    Returns how many joined.
    """
    before = group_size(leader)
    table = ",".join(f'"{x}"' for x in addrs)
    solitary = is_solitary(leader, addrs, ws)
    target = ws if solitary else BUILD
    lua(f'''(function()
  local lead = {win_lua(leader)}
  if not lead then return end
  -- What the user is looking at and typing into: the group's current tab, and whether the
  -- group has focus. Both are put back at the end of this same call. (Joining a window makes
  -- it the current tab and drops the focus of the tab that was current; resetting to tab 1,
  -- as this used to do, also threw the user back to page 1 while they were flipping pages.)
  local cur_addr, had_focus = nil, false
  if lead.group then
    cur_addr = tostring(lead.group.current.address)
    for _, w in ipairs(hl.get_windows()) do
      if w.active then
        for _, m in ipairs(lead.group.members) do
          if tostring(m.address) == tostring(w.address) then had_focus = true end
        end
      end
    end
  else
    cur_addr = tostring(lead.address)
    had_focus = lead.active == true
  end
  {'' if solitary else f'hl.dispatch(hl.dsp.window.move({{ workspace = {BUILD}, window = lead, follow = false }}))'}
  if not lead.group then hl.dispatch(hl.dsp.group.toggle({{ window = lead }})) end
  for _, addr in ipairs({{ {table} }}) do
    local nw
    for _, w in ipairs(hl.get_windows()) do if w.address == addr then nw = w break end end
    if nw then
      hl.dispatch(hl.dsp.group.active({{ index = lead.group.size, window = lead }}))
      hl.dispatch(hl.dsp.window.move({{ workspace = {target}, window = nw, follow = false }}))
    end
  end
  local idx, keep = 1, nil
  for i, m in ipairs(lead.group.members) do
    if tostring(m.address) == cur_addr then idx = i keep = m break end
  end
  hl.dispatch(hl.dsp.group.active({{ index = idx, window = lead }}))
  {'' if solitary else f'hl.dispatch(hl.dsp.window.move({{ workspace = {ws}, window = lead, follow = false }}))'}
  if had_focus and keep then
    local now
    for _, w in ipairs(hl.get_windows()) do if w.active then now = tostring(w.address) end end
    if now ~= cur_addr then hl.dispatch(hl.dsp.focus({{ window = keep }})) end
  end
end)()''')
    want = before + len(addrs) + (1 if before == 0 else 0)
    end = time.time() + 2 + 0.05 * len(addrs)
    while group_size(leader) < want and time.time() < end:
        time.sleep(0.02)
    return max(0, group_size(leader) - (before or 1))


CAPTURE_BIN = os.path.expanduser("~/.config/hypr/winswitch/target/release/winswitch")


def warm_tabs(addrs):
    """Warm every tab by photographing it with the alt+tab capture backend.

    A tab that has never been rendered by the compositor has a cold surface: its first
    reveal flickers (mod+]) and its first capture can come back empty (mod+Tab shows
    only the pages already visited). Capturing makes Hyprland render each window, which
    fixes both; observed: after one full capture pass, switching to a never-visited tab
    no longer flickers. (Cycling through the tabs inside one Lua call does NOT do this:
    no frame is drawn, so nothing is rendered.)

    Done in small chunks, repeating for any tab that did not come back (a capture only
    emits a line when it succeeds), so it stays gentle on the compositor and the CPU.
    The thumbnails land in the backend's cache, which mod+Tab shows straight away.
    """
    if not addrs or not os.path.exists(CAPTURE_BIN):
        return len(addrs)
    todo = list(addrs)
    for attempt in range(10):
        for i in range(0, len(todo), 8):
            chunk = todo[i:i + 8]
            try:
                # SKIP_BLANK: a viewer that has not drawn its first picture yet captures as a
                # flat frame; that is reported as missing here and asked for again below.
                # env=ENV: the same Hyprland instance this script found for itself. Without it a
                # shell that lost HYPRLAND_INSTANCE_SIGNATURE (a tmux pane after a relogin) made the
                # backend see no compositor: every pass reported "0 windows" and nothing was
                # pre-rendered or cached.
                r = subprocess.run(["env", "WINSWITCH_SKIP_BLANK=1", "WINSWITCH_ONLY=" + ",".join(chunk), CAPTURE_BIN],
                                   capture_output=True, text=True, timeout=30, env=ENV)
            except subprocess.TimeoutExpired:
                continue
            for line in r.stdout.splitlines():
                try:
                    m = json.loads(line)
                except ValueError:
                    continue
                if m.get("type") == "thumbnail" and m.get("address") in todo:
                    todo.remove(m["address"])
            time.sleep(0.3)
        if not todo:
            break
        time.sleep(min(1.5, 0.5 + 0.2 * attempt))
    return len(todo)


def group_size(addr):
    for c in clients():
        if c["address"] == addr:
            return len(c["grouped"])
    return 0


def main():
    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("paths", nargs="+")
    ap.add_argument("--workspace", help="open on this workspace instead of the current one")
    ap.add_argument("--fresh", action="store_true", help="use a free empty workspace next to the current one and move the view to it (joins are then re-tile-free)")
    ap.add_argument("--here", action="store_true", help="on a busy workspace, build the group off-screen and drop it in when done (no live joining)")
    ap.add_argument("--no-switch", action="store_true", help="with a fresh workspace: do not move the view to it")
    ap.add_argument("--ferry-live", action="store_true", help="(now the default) join live on the current workspace; each batch on a busy one re-tiles your other windows")
    ap.add_argument("--offscreen", action="store_true", help="build the whole group off-screen, pre-render it, and drop it onto your workspace in one step (default: the first window appears at once and the others join it as they load)")
    ap.add_argument("--no-warm", action="store_true", help="skip the pre-render pass (mod+Tab then captures the tabs itself, retrying until they have drawn)")
    ap.add_argument("--no-pin", action="store_true", help="do not pin the image work to the efficiency cores (faster, but hotter: measured ~27%% less package power when pinned)")
    ap.add_argument("--max-edge", type=int, default=3000, help="open large images as a cached copy scaled to this long edge, in pixels; 0 = open the originals (default 3000)")
    ap.add_argument("--delay", type=float, default=0.15, help="settle time after each window (default 0.15)")
    ap.add_argument("--batch", type=float, default=1.0, help="seconds between merge batches on an empty workspace (default 1.0)")
    ap.add_argument("--ferry", type=float, default=12.0, help="seconds between merge batches on a busy workspace, where each batch briefly takes the group off it (default 12)")
    ap.add_argument("--max-parallel", type=int, default=1, help="most windows loading at once (default 1)")
    ap.add_argument("--launch-gap", type=float, default=0.6, help="minimum seconds between launches (default 0.6)")
    ap.add_argument("--cpu-limit", type=float, default=50, help="back off while CPU use is above this percent (default 50)")
    ap.add_argument("--temp-limit", type=float, default=78, help="pause launching while the CPU is hotter than this, deg C; resumes 10 below (default 78)")
    ap.add_argument("--focus", action="store_true", help="focus the finished group once, if you are still on its workspace (default: focus is never moved)")
    lim = ap.add_mutually_exclusive_group()
    lim.add_argument("--head", type=int, metavar="N", help="only open the first N files")
    lim.add_argument("--tail", type=int, metavar="N", help="only open the last N files")
    a = ap.parse_args()

    files = collect(a.paths)
    if a.head is not None:
        files = files[:max(a.head, 0)]
    elif a.tail is not None:
        files = files[len(files) - max(a.tail, 0):]
    if not files:
        sys.exit("group-open: nothing to open")
    n = len(files)

    global SLICE, ECORES
    ECORES = None if a.no_pin else efficiency_cores()
    SLICE = slice_name(os.path.basename(a.paths[0].rstrip("/")))

    seen = {c["address"] for c in clients()}
    dest = int(a.workspace) if a.workspace else json.loads(hyprctl("activeworkspace", "-j"))["id"]
    # Hyprland merges a window moved onto a workspace that holds only a group into that
    # group, but only while this option is on. It is off in the user's config, so it is
    # switched on for this run and always switched back off (also when killed).
    # Hyprland re-announces the focused window whenever a window opens or moves (even a
    # silent one) and warps the cursor to its centre when it does; measured: one exact-centre
    # warp per run, none with this on. Off for the run, restored in `finally`.
    hyprctl("eval", "hl.config({group={group_on_movetoworkspace=true}, cursor={no_warps=true}})")
    # Where the group is built: a private workspace nobody looks at (default), or dest.
    explicit = bool(a.workspace)
    switched_view = False
    dest_busy = any(c["workspace"]["id"] == dest for c in clients())
    # Joining a window to a visible group re-tiles every other window on that workspace
    # (measured: an X11 neighbour got two resizes per merge batch), and Hyprland only merges
    # silently on a workspace that holds nothing but the group. On an empty workspace the
    # visible slide receives no events at all while windows join (measured). So when the
    # current workspace is busy, the slideshow gets its own empty workspace instead (the
    # free number next to the current one), and the view moves there once, so the first slide is on screen the
    # moment it opens and the rest join it silently. --here stays on the busy workspace and
    # builds the group off-screen (one re-tile when it is dropped in); --no-switch prepares the
    # empty workspace without moving the view.
    use_fresh = a.fresh
    if use_fresh:
        occupied = {w["id"] for w in json.loads(hyprctl("workspaces", "-j") or "[]") if w.get("windows", 0) > 0}
        occupied |= {m["activeWorkspace"]["id"] for m in json.loads(hyprctl("monitors", "-j") or "[]")}
        # the free workspace next to the current one (so it opens beside it in the bar), not
        # simply the lowest free number
        here_id = dest if isinstance(dest, int) and dest > 0 else 0
        dest = next(i for i in list(range(here_id + 1, 9000)) + list(range(1, here_id + 1)) if i not in occupied)
        dest_busy = False
        if a.no_switch:
            print(f"group-open: slides are loading on empty workspace {dest}", file=sys.stderr)
        else:
            lua(f"hl.dispatch(hl.dsp.focus({{ workspace = {dest} }}))")     # the one view change
            switched_view = True
            print(f"group-open: using empty workspace {dest}", file=sys.stderr)
    # default: stay on the current workspace and join live (ferrying the group off it per batch
    # when other windows share it); --here/--offscreen build off-screen and drop in at the end
    mode = "offscreen" if (a.offscreen or (dest_busy and a.here)) else "live"
    home = dest if mode == "live" else BUILD
    signal.signal(signal.SIGTERM, lambda *_: sys.exit(1))   # let `finally` run on kill/timeout

    opened = {}   # file index -> the path actually handed to the viewer (maybe a scaled copy)

    def launch(i, ws):
        opened[i] = scaled_copy(files[i], a.max_edge)
        cmd = command_for(opened[i])
        if cmd is None:
            print(f"[{i + 1}/{n}] {os.path.basename(files[i])}  ->  no application for {mime_of(files[i])}, skipped", file=sys.stderr)
            return False
        note = " (scaled copy)" if opened[i] != files[i] else ""
        print(f"[{i + 1}/{n}] {os.path.basename(files[i])}{note}  ->  {cmd}", file=sys.stderr)
        spawn(cmd, ws)
        return True

    def rank(c):
        try:
            cmdline = open(f"/proc/{c['pid']}/cmdline", "rb").read().decode(errors="replace")
        except OSError:
            return n
        hit = [i for i in range(n) if opened.get(i, files[i]) in cmdline or files[i] in cmdline]
        return hit[0] if hit else n

    def new_windows():
        """Windows that appeared on our private staging workspace since the last call.
        Identified by Hyprland address and workspace only: whatever else is opened or
        focused while this runs can never be picked up."""
        out = []
        for c in clients():
            if c["address"] in seen or not c["mapped"]:
                continue
            if c["workspace"]["id"] == STAGE:
                seen.add(c["address"])
                out.append(c)
        return out

    bg = ThreadPoolExecutor(max_workers=1)   # re-caches tabs while loading continues

    try:
        # The first window opens right here and is never touched while the others
        # load: they open off-screen and are merged in file order, in batches
        # (one Lua call each), so the visible slide sees a few changes, not one
        # per window.
        if not launch(0, STAGE):
            sys.exit("group-open: the first file cannot be opened")
        leader = None
        end = time.time() + TIMEOUT
        while leader is None and time.time() < end:
            first = new_windows()
            if first:
                leader = min(first, key=rank)["address"]   # the file-0 window if several appeared
            else:
                time.sleep(0.1)
        if not leader:
            sys.exit("group-open: first window never appeared")
        move_ws(leader, home)    # silent: nothing gets focus
        time.sleep(a.delay)
        if switched_view:
            # An empty workspace has no focused window, so after moving the view there nothing
            # would receive keystrokes (the viewer's own keys, mod+] on its group) until the
            # mouse happened to move. The view was just moved by this command, so the first
            # slide takes focus once, here; later joins never touch focus.
            focus_if_on(leader, dest)

        pending = {}   # file index -> client
        extra = []     # windows we could not match to a file
        ready = []     # contiguous-from-the-start windows waiting for the next batch
        nxt = 1        # next file index to move into `ready`
        launched = 1   # files handled so far (file 0 is the leader)
        arrived = 0    # windows seen or given up on so far, other than the leader
        started = {}   # file index -> launch time, until its window appears (or we give up)
        skipped = 0
        merged = 0
        # Streamed launches: only `limit` slides are loading at once, started in
        # file order, so they finish roughly in file order and can be merged as
        # they appear. `limit` adapts to measured CPU use: it shrinks when the
        # machine is above --cpu-limit and grows back when there is headroom.
        cpu = Cpu()
        limit = 1
        paused = False
        pause_start = 0.0
        last_launch = 0.0
        last_cpu = last = time.time()
        last_batch = 0.0
        temp = cpu_temp()
        while (launched < n or nxt < n or ready) and time.time() - last < TIMEOUT:
            now = time.time()
            if now - last_cpu >= 0.5:
                busy_pct, temp = cpu.percent(), cpu_temp()
                pressured = psi("cpu") > 40 or psi("memory") > 10
                if temp > a.temp_limit:
                    if not paused:
                        pause_start = now
                    paused = True            # too hot: stop starting anything until it cools
                elif temp < a.temp_limit - 10:
                    paused = False
                if paused and now - pause_start > 90:
                    paused = False           # never cooled: carry on, one window at a time
                if paused or busy_pct > a.cpu_limit or pressured:
                    limit = max(1, limit - 1)
                elif busy_pct < a.cpu_limit - 20:
                    limit = min(a.max_parallel, limit + 1)
                last_cpu = now
                if paused:
                    last = now               # waiting for the machine to cool is not a stall
            if (not paused and launched < n and launched - 1 - arrived < limit
                    and now - last_launch >= a.launch_gap):
                if launch(launched, STAGE):
                    started[launched] = time.time()
                else:                        # nothing to open it with: never blocks the rest
                    pending[launched] = None
                    arrived += 1
                    skipped += 1
                launched += 1
                last_launch = last = time.time()
            for c in new_windows():
                r = rank(c)
                if r < n:
                    pending[r] = c
                    started.pop(r, None)
                else:
                    extra.append(c)
                arrived += 1
                last = time.time()
            for i, t in list(started.items()):     # a window that never comes must not hold up the others
                if time.time() - t > 30:
                    print(f"   (no window for {os.path.basename(files[i])} after 30 s, skipped)", file=sys.stderr)
                    del started[i]
                    pending[i] = None
                    arrived += 1
                    skipped += 1
                    last = time.time()
            while nxt in pending:
                c = pending.pop(nxt)
                if c is not None:
                    ready.append(c["address"])
                nxt += 1
            solitary_now = is_solitary(leader, ready, home)
            gap = a.batch if solitary_now else a.ferry
            if ready and (nxt >= n or time.time() - last_batch >= gap):
                batch_addrs = list(ready)
                joined = merge_batch(leader, ready, home)
                if joined:
                    merged += len(ready)
                    if mode == "live" and not a.no_warm:
                        # A tab that has never been rendered at its current size flickers when
                        # first revealed, so re-cache in the background (never delaying the
                        # loading): just the new tabs when the group's size did not change
                        # (empty workspace), every tab when the batch took the group away and
                        # back (busy workspace), since the size changed twice.
                        todo = batch_addrs if solitary_now else next(
                            (c["grouped"] for c in clients() if c["address"] == leader), batch_addrs)
                        bg.submit(warm_tabs, list(todo))
                    print(f"   merged {len(ready)} (group now {merged + 1}/{n}, loading {launched - 1 - arrived}, parallel {limit}, {temp:.0f}C{', PAUSED (hot)' if paused else ''})", file=sys.stderr)
                    ready = []
                    last = time.time()
                last_batch = time.time()
            time.sleep(0.25)
        rest = ready + [pending[k]["address"] for k in sorted(pending) if pending[k]] + [c["address"] for c in extra]
        if rest:
            merge_batch(leader, rest, home)
        if skipped:
            print(f"   ({skipped} of {n} files could not be opened)", file=sys.stderr)
        # anything of ours that could not be grouped is moved to dest ungrouped, never
        # left stranded on the invisible staging workspace
        for c in clients():
            if c["workspace"]["id"] == STAGE:
                move_ws(c["address"], dest)
                print(f"   (could not group {c['address']}; left on workspace {dest})", file=sys.stderr)
        bg.shutdown(wait=True)    # background re-caching started during loading
        group = next((c["grouped"] for c in clients() if c["address"] == leader), [leader])
        if mode == "offscreen":
            if not a.no_warm and warm_tabs(group):
                print("   (some tabs could not be pre-rendered; their first switch may flicker)", file=sys.stderr)
            # one step: the finished, pre-rendered group goes onto the user's workspace. The merge
            # option must be off first, or a workspace that happens to hold just another group would swallow ours.
            hyprctl("eval", "hl.config({group={group_on_movetoworkspace=false}})")
            move_ws(leader, dest)
            time.sleep(0.5)
        if not a.no_warm:
            # Final pass with the group on its workspace at its final size: what pressing
            # mod+Tab does. (Measured: the revealed tab gets no X11 events, so the first-switch
            # flicker is the compositor presenting a window it has not rendered at this size,
            # not the viewer redrawing.) The tabs already have content, so one pass is enough.
            cold = warm_tabs(group)
            if cold:
                print(f"   ({cold} tab(s) could not be pre-rendered; their first switch may flicker)", file=sys.stderr)
        if a.focus:
            focus_if_on(leader, dest)
    finally:
        hyprctl("eval", "hl.config({group={group_on_movetoworkspace=false}, cursor={no_warps=false}})")


if __name__ == "__main__":
    main()
