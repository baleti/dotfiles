#!/usr/bin/env python3
"""Open files (or every file in the given folders) in their default apps and
stack all the resulting windows into ONE Hyprland group (tabs).

Usage: group-open [--head N | --tail N] [--workspace N] [--delay S] FILE_OR_DIR...

--head N / --tail N open only the first / last N files of the (sorted) list.

Step through the tabs with mod+[ / mod+] (hl.dsp.group.prev/next).
Folder contents are opened in natural sort order ("2 x" before "10 x").

The app for each file is the mime type's default (xdg-mime -> .desktop Exec).
Override per mime type in OVERRIDES; "{}" is replaced by the quoted file path.
"""
import argparse, json, mimetypes, os, re, shlex, subprocess, sys, time

# mime type -> shell command, e.g. {"image/png": "mpv --no-config {}"}
OVERRIDES = {
}

APP_DIRS = [os.path.expanduser("~/.local/share/applications"),
            "/usr/local/share/applications", "/usr/share/applications"]
STAGE, BUILD = 9100, 9101  # off-screen workspaces used while building
TIMEOUT = 20  # seconds to wait for each window to appear


def hypr_env():
    env = dict(os.environ)
    if "HYPRLAND_INSTANCE_SIGNATURE" not in env:
        rt = env.get("XDG_RUNTIME_DIR", f"/run/user/{os.getuid()}") + "/hypr"
        env["HYPRLAND_INSTANCE_SIGNATURE"] = subprocess.check_output(
            f"ls -t {shlex.quote(rt)} | head -1", shell=True, text=True).strip()
    return env


ENV = hypr_env()


def hyprctl(*args):
    return subprocess.run(["hyprctl", *args], env=ENV, capture_output=True, text=True).stdout


def clients():
    return json.loads(hyprctl("clients", "-j") or "[]")


def lua(code):
    return hyprctl("eval", code)


def natural(s):
    return [int(t) if t.isdigit() else t.lower() for t in re.split(r"(\d+)", s)]


def collect(paths):
    out = []
    for p in paths:
        p = os.path.abspath(os.path.expanduser(p))
        if os.path.isdir(p):
            names = sorted((n for n in os.listdir(p) if not n.startswith(".")), key=natural)
            out += [os.path.join(p, n) for n in names if os.path.isfile(os.path.join(p, n))]
        elif os.path.isfile(p):
            out.append(p)
        else:
            sys.exit(f"group-open: no such file or directory: {p}")
    return out


def mime_of(path):
    r = subprocess.run(["xdg-mime", "query", "filetype", path], capture_output=True, text=True)
    return r.stdout.strip() or mimetypes.guess_type(path)[0] or "application/octet-stream"


def desktop_exec(mime):
    d = subprocess.run(["xdg-mime", "query", "default", mime], capture_output=True, text=True).stdout.strip()
    if not d:
        return None
    for base in APP_DIRS:
        f = os.path.join(base, d)
        if os.path.exists(f):
            for line in open(f, errors="replace"):
                if line.startswith("Exec="):
                    return line[5:].strip()
    return None


def command_for(path):
    mime = mime_of(path)
    q = shlex.quote(path)
    if mime in OVERRIDES:
        return OVERRIDES[mime].replace("{}", q)
    ex = desktop_exec(mime)
    if not ex:
        return f"xdg-open {q}"
    ex = re.sub(r"%[fFuU]", q, ex)          # we pass exactly one file
    return re.sub(r"%[a-zA-Z%]", "", ex)    # drop %i %c %k etc.


def spawn(cmd, workspace):
    rule = f"workspace {workspace} silent" if workspace else "silent"
    lua(f'hl.dispatch(hl.dsp.exec_cmd({json.dumps("[" + rule + "] " + cmd)}))')


def wait_new(seen):
    end = time.time() + TIMEOUT
    while time.time() < end:
        new = [c for c in clients() if c["address"] not in seen and c["mapped"]]
        if new:
            return new[0]["address"]
        time.sleep(0.1)
    return None


def win_lua(addr):
    return f'(function() for _,w in ipairs(hl.get_windows()) do if w.address=="{addr}" then return w end end end)()'


def focus(addr):
    lua(f'(function() local w={win_lua(addr)} if w then hl.dispatch(hl.dsp.focus({{window=w}})) end end)()')


def move_ws(addr, ws):
    lua(f'(function() local w={win_lua(addr)} if w then hl.dispatch(hl.dsp.window.move({{workspace={ws}, window=w, follow=false}})) end end)()')


def focus_if_on(addr, ws):
    """Focus addr only if the user is still looking at workspace ws."""
    lua(f'(function() local w={win_lua(addr)} if w and hl.get_active_workspace().id=={ws} then hl.dispatch(hl.dsp.focus({{window=w}})) end end)()')


def pinned_merge(leader, addr, ws):
    """Append addr to leader's group, keeping the leader's tab selected and focused."""
    before = group_size(leader)
    lua(f'''(function()
  local lead, nw = {win_lua(leader)}, {win_lua(addr)}
  if not (lead and nw) then return end
  hl.dispatch(hl.dsp.group.active({{ index = lead.group.size, window = lead }}))
  hl.dispatch(hl.dsp.window.move({{ workspace = {ws}, window = nw, follow = false }}))
  hl.dispatch(hl.dsp.group.active({{ index = 1, window = lead }}))
  if hl.get_active_workspace().id == {ws} then hl.dispatch(hl.dsp.focus({{ window = lead }})) end
end)()''')
    end = time.time() + 2
    while group_size(leader) <= before and time.time() < end:
        time.sleep(0.02)


def group_size(addr):
    for c in clients():
        if c["address"] == addr:
            return len(c["grouped"])
    return 0


def main():
    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("paths", nargs="+")
    ap.add_argument("--workspace", help="open on this workspace instead of the current one")
    ap.add_argument("--delay", type=float, default=0.15, help="settle time after each window (default 0.15)")
    ap.add_argument("--stagger", type=float, default=0.03, help="pause between launches (default 0.03)")
    lim = ap.add_mutually_exclusive_group()
    lim.add_argument("--head", type=int, metavar="N", help="only open the first N files")
    lim.add_argument("--tail", type=int, metavar="N", help="only open the last N files")
    a = ap.parse_args()

    files = collect(a.paths)
    if a.head is not None:
        files = files[:max(a.head, 0)]
    elif a.tail is not None:
        files = files[len(files) - max(a.tail, 0):]
    if not files:
        sys.exit("group-open: nothing to open")
    n = len(files)
    seen = {c["address"] for c in clients()}
    dest = int(a.workspace) if a.workspace else json.loads(hyprctl("activeworkspace", "-j"))["id"]
    # windows join a group by being moved (silently) onto a workspace that holds
    # nothing but that group; that only works when the destination is empty
    inplace = not any(c["workspace"]["id"] == dest for c in clients())
    orig_merge = json.loads(hyprctl("getoption", "group:group_on_movetoworkspace", "-j")).get("bool", False)
    hyprctl("eval", "hl.config({group={group_on_movetoworkspace=true}})")

    def launch(i, ws):
        cmd = command_for(files[i])
        print(f"[{i + 1}/{n}] {os.path.basename(files[i])}  ->  {cmd}", file=sys.stderr)
        spawn(cmd, ws)

    def rank(c):
        try:
            cmdline = open(f"/proc/{c['pid']}/cmdline", "rb").read().decode(errors="replace")
        except OSError:
            return n
        hit = [i for i, f in enumerate(files) if f in cmdline]
        return hit[0] if hit else n

    def new_windows():
        out = []
        for c in clients():
            if c["address"] not in seen and c["mapped"]:
                seen.add(c["address"])
                out.append(c)
        return out

    try:
        if inplace:
            # the first window opens right here and stays the selected tab; the
            # rest open off-screen and are appended behind it. Each join and the
            # re-selection of the first tab happen in one Lua call, so no frame
            # is ever drawn with a different tab or focus.
            launch(0, dest)
            leader = wait_new(seen)
            if not leader:
                sys.exit("group-open: first window never appeared")
            seen.add(leader)
            time.sleep(a.delay)
            lua(f'(function() local w={win_lua(leader)} hl.dispatch(hl.dsp.group.toggle({{window=w}})) end)()')
            focus_if_on(leader, dest)
            for i in range(1, n):
                launch(i, STAGE)
                time.sleep(a.stagger)

            pending = {}   # file index -> client
            extra = []     # windows we could not match to a file
            nxt, last = 1, time.time()
            while nxt < n and time.time() - last < TIMEOUT:
                for c in new_windows():
                    r = rank(c)
                    (pending.__setitem__(r, c) if r < n else extra.append(c))
                    last = time.time()
                while nxt in pending:
                    pinned_merge(leader, pending.pop(nxt)["address"], dest)
                    nxt += 1
                    last = time.time()
                time.sleep(0.05)
            rest = [pending[k] for k in sorted(pending)] + extra   # gaps: files that never opened a window
            for c in rest:
                pinned_merge(leader, c["address"], dest)
            if nxt < n and not rest:
                print(f"   ({n - nxt} window(s) never appeared)", file=sys.stderr)
        else:
            # destination is not empty: build the whole group off-screen, then drop it in
            for i in range(n):
                launch(i, STAGE)
                time.sleep(a.stagger)
            arrived, last = [], time.time()
            while len(arrived) < n and time.time() - last < TIMEOUT:
                got = new_windows()
                arrived += got
                last = time.time() if got else last
                time.sleep(0.1)
            if not arrived:
                sys.exit("group-open: no windows appeared")
            arrived.sort(key=rank)
            leader = arrived[0]["address"]
            move_ws(leader, BUILD)
            time.sleep(a.delay)
            lua(f'(function() local w={win_lua(leader)} hl.dispatch(hl.dsp.group.toggle({{window=w}})) end)()')
            time.sleep(a.delay)
            for c in arrived[1:]:
                before = group_size(leader)
                move_ws(c["address"], BUILD)
                end = time.time() + 2
                while group_size(leader) <= before and time.time() < end:
                    time.sleep(0.02)
            lua(f'(function() local w={win_lua(leader)} hl.dispatch(hl.dsp.group.active({{index=1, window=w}})) end)()')
            move_ws(leader, dest)
            time.sleep(a.delay)
            focus(leader)
    finally:
        hyprctl("eval", f"hl.config({{group={{group_on_movetoworkspace={'true' if orig_merge else 'false'}}}}})")


if __name__ == "__main__":
    main()
