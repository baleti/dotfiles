#!/usr/bin/env bash
# exit-session: close THIS agent's own claude + the shell of its tmux pane.
# Run as the LAST action of a task, e.g. when told "exit after you finish".
# Usage: exit-session [max_wait_seconds=120]  (longest wait for the current turn to end)
# Safe by design: acts only on $TMUX_PANE (own pane), never kills by name,
# never uses kill-pane/kill-session; types /exit then `exit` like the Claude
# Agents app. Detached, so the calling turn can end first. Mirrors
# exit_session() in ~/src/claudeagents-android/server/claude-agents-daemon.py.
set -u
usage="usage: exit-session [max_wait_seconds]  -- closes this agent's claude and its tmux pane"
case "${1:-}" in
  -h|--help) echo "$usage"; exit 0;;
esac
if [ $# -gt 1 ] || { [ $# -eq 1 ] && ! [[ $1 =~ ^[0-9]+$ ]]; }; then echo "$usage" >&2; exit 2; fi
wait_max="${1:-120}"
pane="${TMUX_PANE:-}"
sid="${CLAUDE_CODE_SESSION_ID:-}"
[ -n "$pane" ] || { echo "exit-session: not in tmux (no \$TMUX_PANE); just end your turn" >&2; exit 1; }
# tmux display-message succeeds for missing panes, so check the pane list instead
tmux list-panes -a -F '#{pane_id}' | grep -qxF -- "$pane" || { echo "exit-session: pane $pane not found" >&2; exit 1; }
log=~/.cache/exit-session.log; mkdir -p ~/.cache
# Claude Code's own registry entry for this session carries busy/idle status.
reg=""
[ -n "$sid" ] && reg=$(grep -lF "\"sessionId\":\"$sid\"" "${CLAUDE_CONFIG_DIR:-$HOME/.claude}"/sessions/*.json 2>/dev/null | head -1)
setsid nohup bash -c '
  pane=$1; wait_max=$2; log=$3; reg=$4; sid=$5
  shells=" bash zsh sh fish dash ksh tcsh nu "
  alive() { tmux list-panes -a -F "#{pane_id}" 2>/dev/null | grep -qxF -- "$pane"; }
  say() { echo "$(date -Is) $pane $*" >>"$log"; }
  if [ -n "$reg" ]; then
    end=$((SECONDS+wait_max))
    until grep -qE "\"status\":\"(idle|shell)\"" "$reg" 2>/dev/null; do
      [ -e "$reg" ] || break
      [ $SECONDS -lt $end ] || { say "turn not over after ${wait_max}s, sending /exit anyway"; break; }
      sleep 0.5
    done
    sleep 1
  else
    sleep 15
  fi
  alive || { say "already closed"; exit 0; }
  # tells the Claude Agents daemon/web that this session was closed on purpose
  [ -n "$sid" ] && { mkdir -p ~/.cache/claude-agents/exited; touch ~/.cache/claude-agents/exited/"$sid"; }
  tmux send-keys -t "$pane" C-u; tmux send-keys -t "$pane" -l "/exit"; sleep 0.3; tmux send-keys -t "$pane" Enter
  end=$((SECONDS+120))
  while [ $SECONDS -lt $end ]; do
    alive || { say "closed itself"; exit 0; }
    cmd=$(tmux display -p -t "$pane" "#{pane_current_command}" 2>/dev/null)
    case "$shells" in *" ${cmd:-none} "*)
      tmux send-keys -t "$pane" C-u; tmux send-keys -t "$pane" "exit" Enter
      say "claude exited, shell closed"; exit 0;; esac
    sleep 0.5
  done
  say "still running 120s after /exit, left alone"
' _ "$pane" "$wait_max" "$log" "$reg" "$sid" >/dev/null 2>&1 &
echo "exit-session: will /exit claude and close pane $pane once this turn ends (log: $log). End your turn now."
