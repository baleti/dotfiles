#!/bin/bash
# Launcher entry "RDP: Revit VM". No args: opens the quickshell picker (rdpvm/RdpVmPicker.qml), which calls `--list` each time it opens.
# --list: the Revit VMs running on host2 right now, one per line: cid<TAB>name<TAB>cpus<TAB>mem. Picking one runs rdp-windows-vm <cid>.
if [ "$1" != --list ]; then exec qs ipc call rdpVm toggle; fi
H2=192.168.1.13; KEY=~/.ssh/host2-ssh-auth
ssh -i $KEY -o ConnectTimeout=5 -o BatchMode=yes user@$H2 'ps -eo args | grep "[q]emu-system"' 2>/dev/null | while read -r line; do
  cid=$(grep -oP 'guest-cid=\K[0-9]+' <<<"$line"); [ -n "$cid" ] || continue
  printf '%s\t%s\t%s\t%s\n' "$cid" "$(grep -oP -- '-name \K\S+' <<<"$line")" "$(grep -oP -- '-smp \K\S+' <<<"$line")" "$(grep -oP -- '-m \K\S+' <<<"$line")"
done | sort -n
