#!/bin/bash
# RDP into the offline Windows/Revit VM on host2 (no network in the VM; host3 -> ssh -L -> host2 socat -> vsock CID 3 port 3389 -> guest relay -> RDP).
# usage: rdp-windows-revit-vm [extra xfreerdp3 args]      (asks for the password, then runs in the background; clipboard and drives shared)
# The tunnel is checked END TO END (an RDP handshake must answer); a stale/half-dead tunnel is replaced automatically.
# Stop it manually with: kill $(ss -ltnp | sed -n 's/.*127.0.0.1:33390.*pid=\([0-9]*\).*/\1/p')
PORT=33390
H2=192.168.1.13
KEY=~/.ssh/host2-ssh-auth
probe() { timeout 6 bash -c "exec 3<>/dev/tcp/127.0.0.1/$PORT && printf '\x03\x00\x00\x13\x0e\xe0\x00\x00\x00\x00\x00\x01\x00\x08\x00\x03\x00\x00\x00' >&3 && head -c 4 <&3 | od -An -tx1 | grep -q '03 00'" 2>/dev/null; }
if ! probe; then
  old=$(ss -ltnp 2>/dev/null | sed -n "s/.*127.0.0.1:$PORT.*pid=\([0-9]*\).*/\1/p" | head -1)
  [ -n "$old" ] && kill "$old" 2>/dev/null && sleep 1
  # host2: plain tcp->vsock forwarder (started once, survives)
  ssh -i $KEY user@$H2 'ss -ltn | grep -q 127.0.0.1:34389 || setsid socat TCP-LISTEN:34389,bind=127.0.0.1,fork,reuseaddr VSOCK-CONNECT:3:3389 >/dev/null 2>&1 < /dev/null &' || exit 1
  ssh -i $KEY -o ExitOnForwardFailure=yes -o ServerAliveInterval=30 -f -N -L $PORT:127.0.0.1:34389 user@$H2 || exit 1
  for i in $(seq 1 20); do probe && break; sleep 0.5; done
  probe || { echo "rdp-windows-revit-vm: tunnel is up but the guest RDP does not answer (VM not logged in yet, or guest relay not running?)" >&2; notify-send "Revit VM" "Tunnel is up but guest RDP does not answer (VM not logged in yet?)" 2>/dev/null; exit 1; }
fi
# Password: pinentry-gtk when there is no terminal (launcher), plain silent read otherwise. Never on a command line,
# never on disk: it lives in a shell variable, then travels to xfreerdp3 over a pipe (/args-from:fd:3).
ask_pin() {
  local line pw=""
  coproc PE { pinentry-gtk 2>/dev/null; }
  read -r line <&"${PE[0]}"
  printf 'SETTITLE Revit VM\nSETDESC Windows password for the Revit VM\nSETPROMPT Password:\nGETPIN\n' >&"${PE[1]}"
  while read -r line <&"${PE[0]}"; do
    case $line in
      "D "*) pw=${line#D }; pw=${pw//%25/%}; pw=${pw//%0A/$'\n'}; pw=${pw//%0D/$'\r'};;
      OK*) ;;
      ERR*) break;;
    esac
    [ "${line%% *}" = OK ] && [ -n "$pw" ] && break
  done
  printf 'BYE\n' >&"${PE[1]}" 2>/dev/null; wait "$PE_PID" 2>/dev/null
  REPLY=$pw
}
if [ -t 0 ]; then read -rs -p "Windows password: " pw; echo; else ask_pin; pw=$REPLY; fi
[ -n "$pw" ] || exit 1
args=(/v:127.0.0.1:$PORT /d: /u:User /cert:ignore +dynamic-resolution +clipboard -drives "$@" "/p:$pw")
unset pw REPLY
nohup xfreerdp3 /args-from:fd:3 3< <(printf '%s\n' "${args[@]}") >/dev/null 2>&1 < /dev/null &
disown
unset args
