#!/usr/bin/env python3
"""Quote auto-pairing for fzf-driven pickers (query-dsl.md "Quoted terms").

Bound to fzf's `change` event as `transform(dsl-autopair --state FILE --query={q})`.
fzf gives no caret position, so this only handles a quote typed at the END of the
query (the usual case), detected by the query being the previous one plus one char:
  5"      -> "5"      (wraps the word behind; title:abc" -> title:"abc")
  "       -> ""       (empty spot: pair, caret moved between by `backward-char`)
  "5" then " -> "5"   (typing the closing quote over the auto one steps past it)
Only `"` here (these pickers' tokenizers have no '...' quoting). Backspace never re-pairs (the query shrank).
Prints an fzf action list (empty = leave the query alone). Keep in sync with
DslHighlight.qml / auto_pair() in images main.rs / QueryDsl.autoPair in the Android app.
"""
import argparse, os, sys


def pair_at_end(prev, q):
    """-> (new_query, caret_back) or None. `q` == prev + one typed char."""
    c = q[-1]
    if c != '"' or q[:-1] != prev:    # the fzf pickers' tokenizers know "..." only, not '...'
        return None
    before = prev[-1] if prev else ""
    odd = prev.count('"') % 2 == 1
    space = lambda ch: ch == "" or ch.isspace()
    boundary = lambda ch: space(ch) or ch in ":!"
    if c == '"' and not odd and before == '"':        # closing quote typed over the auto one
        return prev, 0
    if c == '"' and odd:
        return None                                   # closes an open quote
    if boundary(before):
        return q + c, 1                               # empty pair, caret between
    if c == '"':
        b = len(prev)
        while b > 0 and not boundary(prev[b - 1]):
            b -= 1
        return prev[:b] + '"' + prev[b:] + '"', 0
    return None


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("--state", required=True)
    ap.add_argument("--query", default="")
    a = ap.parse_args()
    try:
        prev = open(a.state).read()
    except OSError:
        prev = ""
    q = a.query
    out, final = "", q
    if len(q) == len(prev) + 1 and q.startswith(prev):
        r = pair_at_end(prev, q)
        if r is not None:
            final, back = r
            qfile = a.state + ".q"
            with open(qfile, "w") as f:
                f.write(final)
            out = f"transform-query(cat {qfile})" + "+backward-char" * back
    with open(a.state, "w") as f:
        f.write(final)
    sys.stdout.write(out)


if __name__ == "__main__":
    main()
