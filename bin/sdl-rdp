#!/bin/bash
# Shared launcher for sdl-freerdp3 with the flags we standardised on:
#   -grab-keyboard -grab-mouse: SDL must not grab; Hyprland's rdp-guard submap (Pause toggles) handles key passthrough.
#   /gfx /scale:100 /scale-desktop:100 are added to every launch.
#   After launch, a short watcher un-floats the window if SDL/Hyprland floats it (sdl windows float by default).
# SDL_RDP_NO_GRAB=1 omits the grab flags (experiments only).
# usage: [RDP_PASSWORD=...] sdl-rdp <freerdp args...>   (password, if given, goes via env + /args-from so it is never in ps)
# SDL reports the laptop's 1.5x display scale (the window is created before Hyprland places it) and FreeRDP would
# send it to Windows as desktopScaleFactor=150 on every monitor -> everything huge. Explicit /scale:100
# /scale-desktop:100 override that, giving xfreerdp's look on native Wayland (verified 2026-11-07).
pw=$RDP_PASSWORD; unset RDP_PASSWORD
exec 3< <(
  printf '%s\n' "$@" /gfx /scale:100 /scale-desktop:100 "/log-filters:com.freerdp.client.sdl.disp:DEBUG${SDL_RDP_DEBUG:+,com.freerdp.client.SDL:DEBUG,com.freerdp.channels.disp.client:DEBUG}"
  [ -z "$SDL_RDP_NO_GRAB" ] && printf '%s\n' -grab-keyboard -grab-mouse
  [ -n "$pw" ] && printf '/p:%s\n' "$pw"
)
# SDL only marks its window resizable once the RDP DisplayControl channel is up; the compositor's tiled size,
# configured at map time, was ignored while the window was fixed-size, so the remote desktop would stay at the
# initial 1024x768 until something re-lays-out the window. We watch SDL's own disp log line for that moment and
# refocus the window right then. Why: the compositor's tiled size, configured at map time, was ignored while the
# window was fixed-size; SDL only picks up a new configure on the next focus change (observed: moving the mouse,
# even over another window, fixed it - that just changes focus). A focus-out/in pair makes SDL take the real size
# and send it to Windows. (Pipe output must be unbuffered, hence stdbuf, or the trigger line arrives late.)
ready=$(mktemp -u "${XDG_RUNTIME_DIR:-/tmp}/sdl-rdp-ready.XXXXXX")
stdbuf -o0 -e0 sdl-freerdp3 /args-from:fd:3 \
  > >(while IFS= read -r l; do [ -n "$SDL_RDP_DEBUG" ] && printf '%s\n' "$l" >> "$SDL_RDP_DEBUG"; case $l in *"setting the window as resizable"*) : > "$ready";; esac; done) 2>&1 &
pid=$!
if [ -n "$HYPRLAND_INSTANCE_SIGNATURE" ] || [ -n "$(ls -d "$XDG_RUNTIME_DIR"/hypr/* 2>/dev/null)" ]; then
  [ -n "$HYPRLAND_INSTANCE_SIGNATURE" ] || export HYPRLAND_INSTANCE_SIGNATURE=$(basename "$(ls -dt "$XDG_RUNTIME_DIR"/hypr/* | head -1)")
  (
    hl() { hyprctl eval "for _, w in ipairs(hl.get_windows()) do if w.pid == $pid then $1 end end" >/dev/null 2>&1; }
    nudge() {  # refocus: focus another window on the workspace and straight back (only if this window is the active one)
      hyprctl eval "local rdp; for _, w in ipairs(hl.get_windows()) do if w.pid == $pid then rdp = w end end; local act = hl.get_active_window(); if rdp and act and act.pid == $pid then for _, w in ipairs(hl.get_windows()) do if w ~= rdp and w.workspace and rdp.workspace and w.workspace.id == rdp.workspace.id then hl.dispatch(hl.dsp.focus({ window = w })); hl.dispatch(hl.dsp.focus({ window = rdp })); break end end end" >/dev/null 2>&1
    }
    nudged=0
    # ~30 s, 5x per second, plain hyprctl calls (no event hooks): tile the window if floating; nudge once SDL is ready
    for _ in $(seq 1 150); do
      kill -0 $pid 2>/dev/null || break
      hl "if w.floating then hl.dispatch(hl.dsp.window.float({ action = 'disable', window = w })) end"
      if [ $nudged = 0 ] && [ -e "$ready" ]; then nudged=1; [ -n "$SDL_RDP_DEBUG" ] && echo "$(date +%T.%3N) NUDGE start; hypr size: $(hyprctl clients -j | python3 -c "import json,sys;print([c['size'] for c in json.load(sys.stdin) if c['pid']==$pid])")" >> "$SDL_RDP_DEBUG"; sleep 0.15; nudge; sleep 0.5; nudge; sleep 1.5; nudge; fi
      sleep 0.2
    done
    rm -f "$ready"
  ) &
fi
wait $pid
rm -f "$ready"
